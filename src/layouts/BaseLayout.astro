---
import "../styles/global.css";
import "../styles/pages.css";
// The two above-the-fold faces: Sora 600 (headings) and Inter 400 (body copy).
// Vite returns the hashed asset URL, so the preload always matches the file the
// Fontsource CSS loads — no hard-coded path and no duplicate download.
import inter400Url from "@fontsource/inter/files/inter-latin-400-normal.woff2?url";
import sora600Url from "@fontsource/sora/files/sora-latin-600-normal.woff2?url";
import LanguageSwitcher from "../components/site/LanguageSwitcher";
import ScrollControls from "../components/site/ScrollControls";
import SearchCommand from "../components/site/SearchCommand";
import SiteFooter from "../components/site/SiteFooter";
import SiteHeader from "../components/site/SiteHeader";
import Container from "../components/shared/layout/Container";
import { LOCALE_BOOT_SCRIPT } from "@/client/locale-boot";
import { siteUpdated } from "../lib/io/site-updated";
import { SITE_INDEXABLE } from "../lib/seo";
import { langAttr, ogLocale, resolveLocale, useTranslations } from "../i18n/ui";
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  noAlternates?: boolean;
  /** Keep this page's `<main>` out of the Pagefind index (the 404 route). */
  pagefindIgnore?: boolean;
}

const {
  title,
  description,
  ogType = "website",
  pagefindIgnore = false,
} = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

/*
 * The footer's copyright year is a BUILD-time value, not a runtime clock. The
 * hydrated island receives it as a prop, so its SSR HTML and its first client
 * render always agree (a visitor whose system clock is in another year still
 * sees the year this build was produced for).
 */
const buildYear = new Date().getFullYear();

const site = Astro.site ?? new URL("https://laooozy.github.io");
const pageTitle = title ? `${title} · ${t.home.title}` : t.home.title;
const metaDescription = description;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

/*
 * theme-color must track --bg-base instead of duplicating it as a hex that
 * drifts whenever the token is retuned. tokens.css is the single source of
 * truth, so read it at build time (this layout is server-rendered only).
 */
const tokensCss = readFileSync(
  join(process.cwd(), "src/styles/tokens.css"),
  "utf8",
);
const themeColor = /--bg-base:\s*([^;]+);/.exec(tokensCss)?.[1]?.trim();
if (!themeColor) {
  throw new Error("--bg-base is not declared in src/styles/tokens.css");
}
---

<!doctype html>
<html lang={langAttr[locale]} class="dark">
  <head>
    {/*
     * Pre-paint locale bootstrap: resolves localStorage → navigator.language
     * → default and reflects it on <html> (lang + data-locale) before the
     * first paint, so the CSS locale toggle shows the right language with
     * zero flash. Self-contained inline JS — see src/client/locale-boot.ts.
     */}
    <script is:inline set:html={LOCALE_BOOT_SCRIPT} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={themeColor} />
    {metaDescription && <meta name="description" content={metaDescription} />}
    {/*
     * While SITE_INDEXABLE is false the whole site is kept out of search
     * engines. Flip it to true in src/lib/seo.ts to emit nothing here.
     */}
    {!SITE_INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
    {/*
     * DOCUMENT TITLE POLICY: `document.title` is the build-locale (zh-hant)
     * page title and is deliberately NOT re-rendered when the client locale
     * changes. The URL is the identity (one URL space), and the boot script
     * + lang switcher only mutate `<html lang>` / `data-locale`; a title flip
     * without a navigation would desynchronise the visible tab label from the
     * canonical/OG metadata emitted for this URL. Keep it build-locale unless
     * an explicit task changes the policy.
     */}
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.home.title} />
    <meta property="og:title" content={pageTitle} />
    {metaDescription && (
      <meta property="og:description" content={metaDescription} />
    )}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.home.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    {metaDescription && (
      <meta name="twitter:description" content={metaDescription} />
    )}
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    {/*
     * Self-hosted fonts only: no Google Fonts preconnect or stylesheet. The two
     * critical faces are preloaded from the hashed Vite URLs so the first paint
     * does not wait on the CSS parse; `crossorigin` is required for font
     * preloads even on same-origin requests.
     */}
    <link
      rel="preload"
      href={sora600Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={inter400Url}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    {/*
     * Header and footer are hydrated React islands (task 32): their nav /
     * footer labels render from the client locale store, so the chrome
     * re-renders in place when the language changes — no navigation, no
     * reload. The switcher keeps its own `client:load` island, nested in the
     * header's action cluster so the layout is unchanged: language is a
     * primary control, so it must be interactive on first input rather than
     * waiting for the browser to go idle.
     */}
    <SiteHeader client:load currentPath={Astro.url.pathname}>
      <LanguageSwitcher client:load />
    </SiteHeader>

    {/*
     * The global ⌘K palette is a SIBLING island, never a child of the header:
     * the header owns only the trigger, and this island lazy-loads the dialog
     * chunk on first open. Mounted once here so every route shares one trigger
     * state and one palette.
     */}
    <SearchCommand client:idle />

    {/*
     * `tabindex="-1"` makes the skip link's target programmatically
     * focusable (so focus actually lands in the content, not the bar);
     * the anchor offset comes from `html { scroll-padding-top }` alone.
     */}
    <main
      id="main"
      class="site-main"
      tabindex="-1"
      data-pagefind-body={pagefindIgnore ? undefined : ""}
      data-pagefind-ignore={pagefindIgnore ? "" : undefined}
    >
      <Container>
        <slot />
      </Container>
    </main>

    {/*
     * The footer takes the build year and the validated stamp as serializable
     * props. The island itself never imports `src/lib/io/**` and never reads
     * the clock, so the built HTML and the hydrated render are identical.
     */}
    <SiteFooter client:load year={buildYear} siteUpdated={siteUpdated} />
    <ScrollControls client:load />

    <script>
      /*
       * Scroll-hiding top bar, wired through the client store + DOM adapter
       * instead of raw globals. Single-direction only:
       *  - shown by default and whenever at/near the top;
       *  - hidden ONLY while the page scrolls DOWN;
       *  - ANY upward movement reveals it immediately (no threshold).
       * The decision logic lives in `attachScrollHeader` (vanilla, no island).
       */
      import { attachAtmosphere } from "@/client/atmosphere";
      import { clientDeps } from "@/client/bootstrap";
      import { attachScrollHeader } from "@/client/scroll-header";

      attachScrollHeader(clientDeps);
      attachAtmosphere(clientDeps);
    </script>
  </body>
</html>

<style is:global>
  /*
   * Global (not scoped): the header, nav and footer markup now lives in the
   * hydrated React islands `SiteHeader`/`SiteFooter`, whose elements do not
   * receive Astro's `data-astro-cid-*` scope attribute. The selectors are
   * class-scoped and unique to the chrome, so making them global preserves the
   * exact look without changing any class or value.
   *
   * Sticky (not fixed) so the header keeps its own place in the flow: the
   * document reserves its height and there is zero layout shift when it
   * slides away. Hiding is a GPU-composited transform, never a height change.
   */
  /*
   * The header's layout, surface, nav and disclosure are authored with
   * Tailwind utilities inside `SiteHeader.tsx`; this rule keeps only the
   * scroll-hide contract, which is driven by the `data-hidden` attribute the
   * DOM adapter toggles. `will-change` and the transition stay here so the
   * compositor-only transform keeps working even before hydration.
   */
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
    transform: translateY(0);
    will-change: transform;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .site-header[data-hidden] {
    transform: translateY(-100%);
  }

  /*
   * Background atmosphere. The canvas is created by `attachAtmosphere` (a
   * client module) and sits at the bottom of the page's stacking order:
   * fixed, viewport-sized, and transparent to pointer events so every click
   * lands on the content above it. The content is lifted to `--z-base` so the
   * star dust and lightning read as sitting behind the page, never over it;
   * the sticky header already clears it at `--z-sticky`.
   */
  [data-atmosphere] {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /*
   * The footer's layout, rule and spacing are authored with Tailwind utilities
   * inside `SiteFooter.tsx`. This rule keeps only the stacking contract that
   * lifts both shells above the atmosphere canvas.
   */
  .site-main,
  .site-footer {
    position: relative;
    z-index: var(--z-base);
  }

  .site-main {
    flex: 1;
    padding-block: clamp(var(--space-8), 8vw, var(--space-11));
  }

  /*
   * Reduced motion: the bar never hides and never animates — it simply stays
   * put. The rule also matches the hidden state so it always wins over
   * `.site-header[data-hidden]` regardless of script timing.
   */
  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .site-header[data-hidden] {
      transform: none;
      transition: none;
    }
  }
</style>
