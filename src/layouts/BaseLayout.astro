---
import "../styles/tokens.css";
import "../styles/global.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import Container from "../components/layout/Container.astro";
import LinkButton from "@/components/LinkButton";
import { LOCALE_BOOT_SCRIPT } from "@/client/locale-boot";
import { SITE_INDEXABLE } from "../lib/seo";
import { langAttr, ogLocale, resolveLocale, useTranslations } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  noAlternates?: boolean;
}

const { title, description, ogType = "website" } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const site = Astro.site ?? new URL("https://laooozy.github.io");
const homeHref = getRelativeLocaleUrl(locale);
const pageTitle = title ? `${title} · ${t.home.title}` : t.home.title;
const metaDescription = description ?? t.home.tagline;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;
const year = new Date().getFullYear();

// Nav always targets the HOME page's sections, so from `/blog/` (or any
// sub-page) an anchor like `#about` still resolves to the home hero sections.
// `homeHref` is locale-aware (`/` for zh-hant, `/en/`, `/zh-hans/`).
const navItems = [
  { href: `${homeHref}#about`, label: t.nav.about },
  { href: `${homeHref}#acg`, label: t.nav.acg },
  { href: `${homeHref}#blog`, label: t.nav.blog },
  { href: `${homeHref}#contact`, label: t.nav.contact },
];
---

<!doctype html>
<html lang={langAttr[locale]} class="dark">
	<head>
		{/*
		 * Pre-paint locale bootstrap: resolves localStorage → navigator.language
		 * → default and reflects it on <html> (lang + data-locale) before the
		 * first paint, so the CSS locale toggle shows the right language with
		 * zero flash. Self-contained inline JS — see src/client/locale-boot.ts.
		 */}
		<script is:inline set:html={LOCALE_BOOT_SCRIPT} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0f" />
		<meta name="description" content={metaDescription} />
		{/*
		 * While SITE_INDEXABLE is false the whole site is kept out of search
		 * engines. Flip it to true in src/lib/seo.ts to emit nothing here.
		 */}
		{!SITE_INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={t.home.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale[locale]} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.home.title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">{t.a11y.skipToContent}</a>

		<header class="site-header" data-site-header>
			<div class="site-header__inner container">
				<a class="brand" href={homeHref}>{t.home.title}</a>
				<nav class="site-nav" aria-label={t.a11y.primaryNav}>
					<ul class="site-nav__list">
						{
							navItems.map((item) => (
								<li>
									<a class="site-nav__link" href={item.href}>
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<LanguageSwitcher />
			</div>
		</header>

		<main id="main" class="site-main">
			<Container>
				<slot />
			</Container>
		</main>

		<footer class="site-footer">
			<div class="site-footer__inner container">
				<p class="site-footer__copy">© {year} {t.home.title} · {t.footer.rights}</p>
				<LinkButton href={`${homeHref}#contact`} label={t.nav.contact} />
			</div>
		</footer>

		<script>
			/*
			 * Scroll-hiding top bar. Single-direction only:
			 *  - shown by default and whenever at/near the top;
			 *  - hidden ONLY while the page scrolls DOWN;
			 *  - ANY upward movement reveals it immediately (no threshold).
			 */
			const header = document.querySelector<HTMLElement>('[data-site-header]');
			if (header) {
				const TOP_OFFSET = 8; // px — "near the top" always shows the bar
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
				let lastY = window.scrollY;
				let ticking = false;

				const update = () => {
					const y = window.scrollY;
					const delta = y - lastY;

					if (reduceMotion.matches || y <= TOP_OFFSET) {
						// Reduced motion, or at/near the top: always visible.
						header.removeAttribute('data-hidden');
					} else if (delta > 0) {
						// Scrolling down → hide.
						header.setAttribute('data-hidden', '');
					} else if (delta < 0) {
						// Scrolling up → reveal immediately, no threshold.
						header.removeAttribute('data-hidden');
					}

					lastY = y;
					ticking = false;
				};

				const onScroll = () => {
					if (ticking) return;
					ticking = true;
					requestAnimationFrame(update);
				};

				window.addEventListener('scroll', onScroll, { passive: true });
				reduceMotion.addEventListener('change', update);
				update();
			}
		</script>
	</body>
</html>

<style>
	/*
	 * Sticky (not fixed) so the header keeps its own place in the flow: the
	 * document reserves its height and there is zero layout shift when it
	 * slides away. Hiding is a GPU-composited transform, never a height change.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		padding-block: var(--space-4);
		border-bottom: 1px solid color-mix(in oklab, var(--glass-border) 55%, transparent);
		background: color-mix(in oklab, var(--bg-base) 72%, transparent);
		-webkit-backdrop-filter: blur(var(--glass-blur));
		backdrop-filter: blur(var(--glass-blur));
		transform: translateY(0);
		will-change: transform;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.site-header[data-hidden] {
		transform: translateY(-100%);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-4) var(--space-5);
	}

	.brand {
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		color: var(--text);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--accent);
	}

	.site-nav {
		margin-inline-start: auto;
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-5);
		list-style: none;
	}

	.site-nav__link {
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
	}

	.site-nav__link:hover {
		color: var(--text);
	}

	.site-main {
		padding-block: clamp(var(--space-8), 8vw, var(--space-11));
	}

	.site-footer {
		border-top: 1px solid color-mix(in oklab, var(--glass-border) 40%, transparent);
		padding-block: var(--space-6);
	}

	.site-footer__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	.site-footer__copy {
		max-width: none;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	/*
	 * Reduced motion: the bar never hides and never animates — it simply stays
	 * put. The rule also matches the hidden state so it always wins over
	 * `.site-header[data-hidden]` regardless of script timing.
	 */
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header[data-hidden] {
			transform: none;
			transition: none;
		}
	}
</style>
