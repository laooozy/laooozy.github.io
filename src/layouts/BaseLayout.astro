---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/pages.css";
import LanguageSwitcher from "../components/LanguageSwitcher";
import SiteFooter from "../components/SiteFooter";
import SiteHeader from "../components/SiteHeader";
import Container from "../components/layout/Container";
import { LOCALE_BOOT_SCRIPT } from "@/client/locale-boot";
import { SITE_INDEXABLE } from "../lib/seo";
import { langAttr, ogLocale, resolveLocale, useTranslations } from "../i18n/ui";
import { readFileSync } from "node:fs";
import { join } from "node:path";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  noAlternates?: boolean;
}

const { title, description, ogType = "website" } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const site = Astro.site ?? new URL("https://laooozy.github.io");
const pageTitle = title ? `${title} · ${t.home.title}` : t.home.title;
const metaDescription = description ?? t.home.tagline;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og.png", site).href;

/*
 * theme-color must track --bg-base instead of duplicating it as a hex that
 * drifts whenever the token is retuned. tokens.css is the single source of
 * truth, so read it at build time (this layout is server-rendered only).
 */
const tokensCss = readFileSync(
  join(process.cwd(), "src/styles/tokens.css"),
  "utf8",
);
const themeColor = /--bg-base:\s*([^;]+);/.exec(tokensCss)?.[1]?.trim();
if (!themeColor) {
  throw new Error("--bg-base is not declared in src/styles/tokens.css");
}
---

<!doctype html>
<html lang={langAttr[locale]} class="dark">
	<head>
		{/*
		 * Pre-paint locale bootstrap: resolves localStorage → navigator.language
		 * → default and reflects it on <html> (lang + data-locale) before the
		 * first paint, so the CSS locale toggle shows the right language with
		 * zero flash. Self-contained inline JS — see src/client/locale-boot.ts.
		 */}
		<script is:inline set:html={LOCALE_BOOT_SCRIPT} />
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content={themeColor} />
		<meta name="description" content={metaDescription} />
		{/*
		 * While SITE_INDEXABLE is false the whole site is kept out of search
		 * engines. Flip it to true in src/lib/seo.ts to emit nothing here.
		 */}
		{!SITE_INDEXABLE && <meta name="robots" content="noindex, nofollow" />}
		{/*
		 * DOCUMENT TITLE POLICY: `document.title` is the build-locale (zh-hant)
		 * page title and is deliberately NOT re-rendered when the client locale
		 * changes. The URL is the identity (one URL space), and the boot script
		 * + lang switcher only mutate `<html lang>` / `data-locale`; a title flip
		 * without a navigation would desynchronise the visible tab label from the
		 * canonical/OG metadata emitted for this URL. Keep it build-locale unless
		 * an explicit task changes the policy.
		 */}
		<title>{pageTitle}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content={ogType} />
		<meta property="og:site_name" content={t.home.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content={ogLocale[locale]} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={t.home.title} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
		/>
	</head>
	<body>
		{/*
		 * Header and footer are hydrated React islands (task 32): their nav /
		 * footer labels render from the client locale store, so the chrome
		 * re-renders in place when the language changes — no navigation, no
		 * reload. The switcher keeps its own `client:idle` island, nested in the
		 * header's flex row so the layout is unchanged.
		 */}
		<SiteHeader client:load currentPath={Astro.url.pathname}>
			<LanguageSwitcher client:idle />
		</SiteHeader>

		{/*
		 * `tabindex="-1"` makes the skip link's target programmatically
		 * focusable (so focus actually lands in the content, not the bar);
		 * the anchor offset comes from `html { scroll-padding-top }` alone.
		 */}
		<main id="main" class="site-main" tabindex="-1" data-pagefind-body>
			<Container>
				<slot />
			</Container>
		</main>

		<SiteFooter client:load />

		<script>
			/*
			 * Scroll-hiding top bar, wired through the client store + DOM adapter
			 * instead of raw globals. Single-direction only:
			 *  - shown by default and whenever at/near the top;
			 *  - hidden ONLY while the page scrolls DOWN;
			 *  - ANY upward movement reveals it immediately (no threshold).
			 * The decision logic lives in `attachScrollHeader` (vanilla, no island).
			 */
			import { clientDeps } from "@/client/bootstrap";
			import { attachScrollHeader } from "@/client/scroll-header";
			import { attachAtmosphere } from "@/client/atmosphere";

			attachScrollHeader(clientDeps);
			attachAtmosphere(clientDeps);
		</script>
	</body>
</html>

<style is:global>
	/*
	 * Global (not scoped): the header, nav and footer markup now lives in the
	 * hydrated React islands `SiteHeader`/`SiteFooter`, whose elements do not
	 * receive Astro's `data-astro-cid-*` scope attribute. The selectors are
	 * class-scoped and unique to the chrome, so making them global preserves the
	 * exact look without changing any class or value.
	 *
	 * Sticky (not fixed) so the header keeps its own place in the flow: the
	 * document reserves its height and there is zero layout shift when it
	 * slides away. Hiding is a GPU-composited transform, never a height change.
	 */
	.site-header {
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		padding-block: var(--space-4);
		border-bottom: 1px solid color-mix(in oklab, var(--glass-border) 55%, transparent);
		background: color-mix(in oklab, var(--bg-base) 72%, transparent);
		-webkit-backdrop-filter: blur(var(--glass-blur));
		backdrop-filter: blur(var(--glass-blur));
		transform: translateY(0);
		will-change: transform;
		transition: transform var(--dur-base) var(--ease-out);
	}

	.site-header[data-hidden] {
		transform: translateY(-100%);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		flex-wrap: nowrap;
		gap: var(--space-4) var(--space-5);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		font-size: var(--text-lg);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		color: var(--text);
		text-decoration: none;
	}

	.brand:hover {
		color: var(--accent-text);
	}

	.site-nav {
		margin-inline-start: auto;
	}

	.site-nav__list {
		display: flex;
		flex-wrap: nowrap;
		gap: var(--space-5);
		list-style: none;
	}

	.site-nav__link {
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
	}

	.site-nav__link:hover {
		color: var(--text);
	}

	.site-nav__link[aria-current="page"] {
		color: var(--text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, var(--text-muted) 55%, transparent);
		text-decoration-thickness: 1px;
		text-underline-offset: var(--space-1);
	}

	.site-actions {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
	}

	/* Disclosure is a compact-header control only; the desktop nav owns wide
	   screens. */
	.site-menu {
		display: none;
	}

	.site-menu__trigger {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		inline-size: 44px;
		block-size: 44px;
		padding: 0;
		border: 1px solid var(--control-border);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text-muted);
		list-style: none;
		cursor: pointer;
		transition:
			color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	.site-menu__trigger::-webkit-details-marker {
		display: none;
	}

	.site-menu__trigger:hover {
		color: var(--text);
		border-color: var(--control-border-strong);
		background: var(--surface-hover);
	}

	.site-menu__panel {
		position: absolute;
		inset-inline: 0;
		top: 100%;
		z-index: var(--z-dropdown);
		max-block-size: calc(100dvh - 72px);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: var(--space-2) clamp(var(--space-4), 4vw, var(--space-6)) var(--space-3);
		border-block-end: 1px solid color-mix(in oklab, var(--glass-border) 55%, transparent);
		background: var(--bg-deep);
	}

	.site-menu__list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-menu__link {
		display: flex;
		align-items: center;
		min-block-size: 44px;
		padding-inline: var(--space-2);
		border-radius: var(--radius-sm);
		color: var(--text-muted);
		font-size: var(--text-base);
		font-weight: 500;
		text-decoration: none;
	}

	.site-menu__link:hover {
		color: var(--text);
		background: var(--surface-hover);
	}

	.site-menu__link[aria-current="page"] {
		color: var(--text);
		background: var(--accent-soft);
	}

	/*
	 * Below 622px brand + five nav labels + the language trigger no longer fit on
	 * one row (English is the widest locale), so the compact row takes over: the
	 * desktop nav is hidden, the disclosure button appears, and the language
	 * trigger drops its visible label (see LanguageSwitcher's compact rules).
	 */
	@media (max-width: 621px) {
		.site-header {
			padding-block: var(--space-3);
		}

		.site-nav {
			display: none;
		}

		.site-actions {
			margin-inline-start: auto;
		}

		.site-menu {
			display: block;
		}

		.brand {
			min-block-size: 44px;
		}
	}

	/*
	 * Background atmosphere. The canvas is created by `attachAtmosphere` (a
	 * client module) and sits at the bottom of the page's stacking order:
	 * fixed, viewport-sized, and transparent to pointer events so every click
	 * lands on the content above it. The content is lifted to `--z-base` so the
	 * star dust and lightning read as sitting behind the page, never over it;
	 * the sticky header already clears it at `--z-sticky`.
	 */
	[data-atmosphere] {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
		pointer-events: none;
	}

	.site-main,
	.site-footer {
		position: relative;
		z-index: var(--z-base);
	}

	.site-main {
		flex: 1;
		padding-block: clamp(var(--space-8), 8vw, var(--space-11));
	}

	.site-footer {
		border-top: 1px solid color-mix(in oklab, var(--glass-border) 40%, transparent);
		padding-block: var(--space-6);
	}

	.site-footer__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: var(--space-4);
	}

	@media (max-width: 29.99rem) {
		.site-footer__inner {
			flex-direction: column;
			align-items: flex-start;
		}
	}

	.site-footer__copy {
		max-width: none;
		margin: 0;
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	/*
	 * Reduced motion: the bar never hides and never animates — it simply stays
	 * put. The rule also matches the hidden state so it always wins over
	 * `.site-header[data-hidden]` regardless of script timing.
	 */
	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.site-header[data-hidden] {
			transform: none;
			transition: none;
		}
	}
</style>
