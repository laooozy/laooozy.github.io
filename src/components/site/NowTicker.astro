---
/**
 * NowTicker — the home hero's "now" line.
 *
 * Reads and validates `src/data/now.json` at BUILD time through the I/O edge
 * (a malformed file fails the build), then renders nothing when the array is
 * empty so the whole `.hero__status` row disappears and the hero gap closes.
 * The hydrated client island supplies the marquee + pause/play enhancement; the
 * server-rendered base stays a static, readable line.
 *
 * This is a thin Astro wrapper, never a React child: the island needs
 * `client:load`, which only Astro can place.
 */
import NowTickerClient from "./NowTickerClient";
import { nowItems } from "../../lib/io/now";
---

{nowItems.length > 0 && <NowTickerClient client:load items={nowItems} />}
