---
/**
 * Hero — the home masthead wrapper.
 *
 * This stays an Astro component for exactly one reason: the "now" status line
 * (`NowTicker`) reads and validates `src/data/now.json` at BUILD time and
 * renders the hydrated `NowTickerClient` island. React cannot top-level await,
 * and a `client:load` directive only exists on an Astro-rendered island, so the
 * ticker must remain a sibling of the React body rather than a child of it.
 *
 * The presentational identity block is `shared/HeroView` (React) and the spec
 * panel is `shared/HeroMeta` (React); both render statically. The ticker is
 * rendered here, inside `.hero__main`, before the identity block so the SSR
 * order is unchanged.
 *
 * Props
 *  - title: string                     the wordmark (rendered as <h1>)
 *  - tagline?: string                  one-line description; mapped to HeroView's `lead`
 *  - meta?: { label; value; href? }[]  right-column spec rows
 *  - className?: string
 */
import type { HeroMetaItem } from "../shared/HeroMeta";
import HeroMeta from "../shared/HeroMeta";
import HeroView from "../shared/HeroView";
import NowTicker from "./NowTicker.astro";

interface Props {
  title: string;
  tagline?: string;
  meta?: HeroMetaItem[];
  className?: string;
}

const { title, tagline, meta = [], className } = Astro.props;
---

<header
  class:list={[
    "hero relative grid min-w-0 gap-[var(--space-8)] pb-[clamp(var(--space-4),3vw,var(--space-6))] lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-center lg:gap-[var(--space-10)]",
    className,
  ]}
>
  <div class="hero__main relative z-[1] flex min-w-0 flex-col items-start gap-[var(--space-5)] motion-safe:[&>*]:animate-rise motion-safe:[&>*:nth-child(2)]:animate-rise-2 motion-safe:[&>*:nth-child(3)]:animate-rise-3 motion-safe:[&>*:nth-child(4)]:animate-rise-4">
    <NowTicker />
    <HeroView title={title} lead={tagline}>
      <slot />
    </HeroView>
  </div>

  <HeroMeta meta={meta} />
</header>
