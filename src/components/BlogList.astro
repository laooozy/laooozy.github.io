---
/**
 * BlogList — the single shared renderer for every blog listing: the paginated
 * per-locale index, tag pages, and date-archive pages.
 *
 * It renders exactly one `<Card href>` per post. Paging is build-time (driven
 * by the `pagination` prop, produced by Astro's `paginate()`); no post data is
 * shipped to the client for DOM paging.
 */
import Card from "./Card.astro";
import SearchModal from "./SearchModal.astro";
import { useTranslations, type Locale } from "../i18n/ui";
import { blogPostPath, formatPostDate, type Post } from "../lib/blog";

interface FilterLink {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  posts: Post[];
  locale: Locale;
  heading: string;
  tags?: FilterLink[];
  periods?: FilterLink[];
  pagination?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const {
  posts,
  locale,
  heading,
  tags = [],
  periods = [],
  pagination,
} = Astro.props;
const t = useTranslations(locale);
const pageLabel = pagination
  ? t.blog.pageOf
      .replace("{current}", String(pagination.currentPage))
      .replace("{last}", String(pagination.lastPage))
  : "";
---

<section class="blog-index" aria-labelledby="blog-heading">
	<header class="blog-index__header">
		<h1 id="blog-heading" class="blog-index__title">{heading}</h1>
		<SearchModal locale={locale} />
	</header>

	{
		(tags.length > 0 || periods.length > 0) && (
			<nav class="blog-filters" aria-label={t.blog.filters}>
				{periods.length > 0 && (
					<div class="blog-filters__group">
						<span class="blog-filters__label">{t.blog.byDate}</span>
						<ul class="blog-filters__list">
							{periods.map((period) => (
								<li>
									<a
										class:list={['chip', period.active && 'chip--active']}
										href={period.href}
										aria-current={period.active ? 'true' : undefined}
									>
										{period.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
				{tags.length > 0 && (
					<div class="blog-filters__group">
						<span class="blog-filters__label">{t.blog.byTag}</span>
						<ul class="blog-filters__list">
							{tags.map((tag) => (
								<li>
									<a
										class:list={['chip', tag.active && 'chip--active']}
										href={tag.href}
										aria-current={tag.active ? 'true' : undefined}
									>
										{tag.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}
			</nav>
		)
	}

	{
		posts.length > 0 ? (
			<ul class="blog-list">
				{posts.map((post) => (
					<li class="blog-list__item">
						<Card href={blogPostPath(locale, post.id)}>
							<time
								class="blog-entry__date"
								datetime={post.data.date.toISOString()}
							>
								{formatPostDate(post.data.date, locale)}
							</time>
							<h2 class="blog-entry__title">{post.data.title}</h2>
							<p class="blog-entry__desc">{post.data.description}</p>
							{post.data.tags.length > 0 && (
								<ul class="blog-entry__tags">
									{post.data.tags.map((tag) => (
										<li class="blog-entry__tag">{tag}</li>
									))}
								</ul>
							)}
						</Card>
					</li>
				))}
			</ul>
		) : (
			<p class="blog-empty">{t.blog.empty}</p>
		)
	}

	{
		pagination && pagination.lastPage > 1 && (
			<nav class="pagination" aria-label={pageLabel}>
				{pagination.url.prev ? (
					<a class="pagination__link" href={pagination.url.prev} rel="prev">
						← {t.blog.prev}
					</a>
				) : (
					<span class="pagination__link pagination__link--disabled" aria-hidden="true">
						← {t.blog.prev}
					</span>
				)}
				<span class="pagination__status">{pageLabel}</span>
				{pagination.url.next ? (
					<a class="pagination__link" href={pagination.url.next} rel="next">
						{t.blog.next} →
					</a>
				) : (
					<span class="pagination__link pagination__link--disabled" aria-hidden="true">
						{t.blog.next} →
					</span>
				)}
			</nav>
		)
	}
</section>

<style>
	.blog-index__header {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-bottom: var(--space-6);
	}

	.blog-index__title {
		margin: 0;
	}

	.blog-filters {
		display: grid;
		gap: var(--space-4);
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-6);
		border-bottom: 1px solid
			color-mix(in oklab, var(--glass-border) 40%, transparent);
	}

	.blog-filters__group {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-3);
	}

	.blog-filters__label {
		font-size: var(--text-xs);
		font-weight: 600;
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.blog-filters__list {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		list-style: none;
	}

	.chip {
		display: inline-block;
		padding: var(--space-1) var(--space-3);
		border: 1px solid
			color-mix(in oklab, var(--glass-border) 55%, transparent);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--text-muted);
		font-size: var(--text-sm);
		text-decoration: none;
		transition: color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			background-color var(--dur-fast) var(--ease-out);
	}

	.chip:hover,
	.chip:focus-visible {
		color: var(--text);
		border-color: var(--glass-border-strong);
		background: var(--surface-hover);
	}

	.chip--active {
		color: var(--text-on-accent);
		border-color: transparent;
		/* Solid --accent, not the gradient: dark-on-#7c3aed only reaches 3.47:1. */
		background: var(--accent);
		font-weight: 600;
	}

	.blog-list {
		display: grid;
		gap: var(--space-5);
		list-style: none;
	}

	.blog-entry__date {
		display: block;
		margin-bottom: var(--space-2);
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-wide);
		color: var(--text-muted);
	}

	.blog-entry__title {
		margin: 0 0 var(--space-2);
		font-size: var(--text-xl);
	}

	.blog-entry__desc {
		margin: 0;
		color: var(--text-muted);
	}

	.blog-entry__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
		list-style: none;
	}

	.blog-entry__tag {
		padding: 0 var(--space-2);
		border-radius: var(--radius-sm);
		background: var(--accent-soft);
		color: var(--text);
		font-size: var(--text-xs);
	}

	.blog-empty {
		margin: 0;
		color: var(--text-muted);
	}

	.pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-4);
		margin-top: var(--space-8);
		padding-top: var(--space-6);
		border-top: 1px solid
			color-mix(in oklab, var(--glass-border) 40%, transparent);
	}

	.pagination__link {
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--accent);
		text-decoration: none;
	}

	.pagination__link:hover {
		color: var(--text);
	}

	.pagination__link--disabled {
		color: var(--text-muted);
		opacity: 0.5;
	}

	.pagination__status {
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: reduce) {
		.chip {
			transition: none;
		}
	}
</style>
