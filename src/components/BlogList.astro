---
/**
 * BlogList — the single shared renderer for every blog listing: the paginated
 * per-locale index, tag pages, and date-archive pages.
 *
 * Composition (all from the reusable kit):
 *  - a masthead (`Heading` level 1 + the `SearchModal` trigger),
 *  - the build-time filter tray (`BlogFilters`),
 *  - the post list — one `PostCard` (variant="row") per post, a wide glass
 *    entry with a mono date rail,
 *  - `BlogPagination` when the set spans more than one page.
 *
 * Paging is build-time (driven by the `pagination` prop from Astro's
 * `paginate()`); no post data is shipped to the client for DOM paging. All copy
 * is i18n-driven.
 */
import PostCard from "./PostCard";
import BlogFilters from "./BlogFilters";
import BlogPagination from "./BlogPagination";
import SearchModal from "./SearchModal.astro";
import Heading from "./ui/Heading";
import Text from "./ui/Text";
import { useTranslations, type Locale } from "../i18n/ui";
import {
  blogPostPath,
  estimateReadingTime,
  formatPostDate,
  type Post,
} from "../lib/blog";

interface FilterLink {
  label: string;
  href: string;
  active?: boolean;
}

interface Props {
  posts: Post[];
  locale: Locale;
  heading: string;
  tags?: FilterLink[];
  periods?: FilterLink[];
  pagination?: {
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const {
  posts,
  locale,
  heading,
  tags = [],
  periods = [],
  pagination,
} = Astro.props;
const t = useTranslations(locale);
---

<section class="blog-index" aria-labelledby="blog-heading">
  <header class="blog-index__header">
    <Heading level={1} id="blog-heading" className="blog-index__title">
      {heading}
    </Heading>
    <SearchModal locale={locale} />
  </header>

  {
    tags.length > 0 && (
      <BlogFilters locale={locale} tags={tags} periods={periods} />
    )
  }

  {
    posts.length > 0 ? (
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <PostCard
              variant="row"
              href={blogPostPath(locale, post.id)}
              title={post.data.title}
              description={post.data.description}
              dateLabel={formatPostDate(post.data.date, locale)}
              datetime={post.data.date.toISOString()}
              readingTime={t.blog.readTime.replace(
                "{minutes}",
                String(estimateReadingTime(post.body)),
              )}
              tags={post.data.tags}
            />
          </li>
        ))}
      </ul>
    ) : (
      <Text tone="muted">{t.blog.empty}</Text>
    )
  }

  {
    pagination && pagination.lastPage > 1 && (
      <BlogPagination locale={locale} pagination={pagination} />
    )
  }
</section>

<style>
  .blog-index {
    display: grid;
    gap: clamp(var(--space-6), 3vw, var(--space-8));
  }

  .blog-index__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
  }

  /* `Heading` is a child component; Astro does not carry this scope id onto
   * its root, so opt this override out of scoping. */
  :global(.blog-index__title) {
    margin: 0;
  }

  .blog-list {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
