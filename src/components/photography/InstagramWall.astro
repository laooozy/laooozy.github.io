---
/**
 * InstagramWall — the photography at-rest portfolio index.
 *
 * This component OWNS the build-time network I/O: it resolves the permalinks in
 * `src/data/instagram.ts` through Meta's oEmbed endpoint with
 * `await getInstagramEmbeds(...)` and renders the already-resolved result. The
 * route (`src/pages/photographer.astro`) stays a thin MDX renderer and never
 * fetches.
 *
 * `INSTAGRAM_OEMBED_FIXTURE=1` opts a local/CI E2E build into deterministic
 * fixture markup with NO network request. It must stay unset for production
 * builds, which call Meta live (and fall back to link cards on any failure).
 *
 * Two layers, deliberately separated:
 *
 *  1. The AT-REST surface is a numbered portfolio index built ONLY from the
 *     local `instagramPosts` list: one large card per post with its ordinal,
 *     the owner's handle and the post path. It loads no image URL, no provider
 *     thumbnail and no iframe, so the page is a designed index before any
 *     third-party asset is allowed to load. The cards map the local list, not
 *     the oEmbed result, so an offline build (or a deleted post) still renders
 *     the full index.
 *  2. The build-time oEmbed blockquotes stay in the DOM inside `.ig-embeds`,
 *     which is `hidden` until consent. Keeping them server-rendered preserves
 *     the privacy-safe fallback and lets the consent gate reveal real markup
 *     instead of re-fetching.
 *
 * The embed.js loader is NOT emitted here and never loads at rest: the
 * `InstagramGate` island (`client:idle`) injects it through the DomPort only
 * after a click, then reveals the hidden blockquote layer. On a provider
 * failure it leaves the index and shows a local fallback instead.
 *
 * Meta's embed.js creates the final `<iframe>` itself, so build-time markup
 * cannot set that iframe's `title`/`loading`. The figure therefore carries the
 * wrapper label (`aria-label`) and the CSS constrains every embed descendant to
 * the figure width; this is the documented Meta limitation allowed by the plan.
 *
 * The cards reuse the project's `card-surface` utility directly rather than the
 * shared React `Card` component: each card is one external anchor, so it needs
 * `target`/`rel` on that anchor, which the hook-free `Card` does not forward.
 */
import { CONTACT } from "../../lib/site";
import { instagramPosts } from "../../data/instagram";
import { getInstagramEmbeds } from "../../lib/io/instagram";
import InstagramGate from "./InstagramGate.tsx";

const instagramMode =
  process.env.INSTAGRAM_OEMBED_FIXTURE === "1" ? "fixture" : "live";
const embeds = await getInstagramEmbeds(instagramPosts, {
  mode: instagramMode,
});
const igHandle = `@${CONTACT.photoIg}`;
const igHref = `https://instagram.com/${CONTACT.photoIg}`;

/** `/p/<shortcode>/` for a post, or the raw URL if it cannot be parsed. */
function postPath(url: string): string {
  try {
    const { pathname } = new URL(url);
    return pathname.endsWith("/") ? pathname : `${pathname}/`;
  } catch {
    return url;
  }
}

/** Two-digit catalogue ordinal: `01`, `02`, … */
function ordinal(position: number): string {
  return String(position).padStart(2, "0");
}
---

{instagramPosts.length > 0 ? (
  <div
    class="photo-index grid min-w-0 max-w-full gap-[var(--space-6)]"
    data-ig-wall
  >
    {/*
        Click-to-load consent gate. `client:idle` keeps it off the critical path;
        it injects embed.js only on click and toggles the layers below through
        the DomPort, so no third-party request happens at rest.
      */}
    <InstagramGate
      client:idle
      scriptSrc="https://www.instagram.com/embed.js"
      profileHref={igHref}
      handle={igHandle}
      postCount={instagramPosts.length}
    />

    {/*
        The at-rest index. Every card is local: an ordinal, the handle and the
        post path. It stays a plain external link so a visitor can always reach
        the post even when the provider is blocked. `data-ig-gate` is the hook
        the consent gate uses to retire this list once the real embeds load; it
        never removes the list on a load failure.
      */}
    <ol
      class="photo-index__list m-0 grid list-none grid-cols-1 gap-[var(--space-4)] p-0 [&[hidden]]:hidden md:grid-cols-2 md:gap-[var(--space-5)]"
      data-ig-gate
    >
      {instagramPosts.map((url, position) => (
        <li class="photo-index__item min-w-0">
          <a
            class="card-surface card-interactive photo-index__card group grid h-full min-h-[13rem] min-w-0 grid-rows-[auto_1fr_auto] gap-[var(--space-5)] overflow-hidden md:min-h-[16rem]"
            href={url}
            target="_blank"
            rel="noopener"
          >
            <span
              class="photo-index__number font-heading text-[length:var(--text-4xl)] font-semibold tracking-[var(--tracking-display)] text-[var(--accent)] tabular-nums leading-none"
              aria-hidden="true"
            >
              {ordinal(position + 1)}
            </span>
            <span class="photo-index__body flex min-w-0 flex-col justify-end gap-[var(--space-2)]">
              <span class="photo-index__handle font-mono text-[length:var(--text-sm)] tracking-[var(--tracking-wide)] text-[var(--text-muted)]">
                {igHandle}
              </span>
              <span class="photo-index__path font-heading text-[length:var(--text-2xl)] font-semibold leading-[var(--leading-tight)] tracking-[var(--tracking-tight)] text-[var(--text)] [overflow-wrap:anywhere]">
                {postPath(url)}
              </span>
            </span>
            <span class="photo-index__action inline-flex items-center gap-[var(--space-2)] text-[length:var(--text-sm)] font-semibold text-[var(--accent-text)]">
              在 Instagram 觀看
              <svg
                class="photo-index__arrow size-4 transition-transform duration-[var(--dur-fast)] ease-brand group-hover:translate-x-[2px] group-hover:-translate-y-[2px] group-focus-visible:translate-x-[2px] group-focus-visible:-translate-y-[2px]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ol>

    {/*
        Consent-gated layer. `hidden` keeps the raw oEmbed blockquotes and the
        per-post link fallback out of paint (and out of the accessibility tree)
        until the gate reveals them. `data-ig-embeds` is the hook the gate uses.
        One column on phones, two from `md` up; `data-pagefind-ignore` keeps
        the third-party markup out of the search index.
      */}
    <div
      class="ig-embeds photo-wall grid min-w-0 max-w-full grid-cols-1 items-start gap-5 [&[hidden]]:hidden md:grid-cols-2"
      data-ig-embeds
      data-pagefind-ignore
      hidden
    >
      {embeds.map((embed) =>
        embed.html ? (
          <figure
            class="ig-embed embed-frame relative isolate m-0 w-full min-w-0 max-w-full overflow-hidden rounded-[var(--radius-lg)] border border-[var(--glass-border)] bg-[var(--surface)] [background-image:var(--card-bg)] shadow-[var(--card-inset)]"
            role="group"
            aria-label={`Instagram post: ${embed.url}`}
            set:html={embed.html}
          />
        ) : (
          <a
            class="ig-fallback flex min-h-[12rem] flex-col items-center justify-center gap-[var(--space-3)] rounded-[var(--radius-lg)] border border-[var(--glass-border)] bg-[var(--surface)] p-[var(--space-6)] text-center text-[var(--text)] no-underline shadow-[var(--card-inset)] [background-image:var(--card-bg)] transition-[border-color,background-color] duration-[var(--dur-base)] ease-brand hover:border-[var(--glass-border-strong)] hover:bg-[var(--surface-hover)] hover:text-[var(--text)] focus-visible:border-[var(--glass-border-strong)] focus-visible:bg-[var(--surface-hover)] focus-visible:text-[var(--text)]"
            href={embed.url}
            target="_blank"
            rel="noopener"
            aria-label={`在 Instagram 觀看 ${igHandle} 的貼文 ${postPath(embed.url)}`}
            data-embed-failed={embed.failed ? "" : undefined}
          >
            <span
              class="ig-fallback__glyph grid size-10 place-items-center rounded-[var(--radius-pill)] bg-[var(--accent-surface)] text-[var(--accent)] [&_svg]:size-[1.1rem]"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M7 17 17 7" />
                <path d="M9 7h8v8" />
              </svg>
            </span>
            <span class="ig-fallback__label text-[length:var(--text-sm)] font-medium text-[var(--text-muted)]">
              在 Instagram 觀看
            </span>
          </a>
        ),
      )}
    </div>
  </div>
) : (
  <a
    class="photo-empty flex flex-wrap items-center gap-[var(--space-3)] rounded-[var(--radius-lg)] border border-[var(--glass-border)] bg-[var(--surface)] p-[var(--space-6)] text-[var(--text)] no-underline shadow-[var(--card-inset)] [background-image:var(--card-bg)] transition-[border-color,background-color] duration-[var(--dur-base)] ease-brand hover:border-[var(--glass-border-strong)] hover:bg-[var(--surface-hover)]"
    href={igHref}
    target="_blank"
    rel="noopener"
  >
    <span class="photo-empty__label font-semibold">在 Instagram 看更多</span>
    <span class="photo-empty__handle font-mono text-[length:var(--text-sm)] text-[var(--text-muted)]">
      {igHandle}
    </span>
    <span
      class="photo-empty__arrow ms-auto text-[var(--accent)]"
      aria-hidden="true"
    >
      ↗
    </span>
  </a>
)}
