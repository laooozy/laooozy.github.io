---
/**
 * InstagramWall — the photography at-rest portfolio index.
 *
 * This component OWNS the build-time network I/O: it resolves the permalinks in
 * `src/data/instagram.ts` through Meta's oEmbed endpoint with
 * `await getInstagramEmbeds(...)` and renders the already-resolved result. The
 * route (`src/pages/photographer.astro`) stays a thin MDX renderer and never
 * fetches.
 *
 * Two layers, deliberately separated:
 *
 *  1. The AT-REST surface is a numbered portfolio index built ONLY from the
 *     local `instagramPosts` list: one large card per post with its ordinal,
 *     the owner's handle and the post path. It loads no image URL, no provider
 *     thumbnail and no iframe, so the page is a designed index before any
 *     third-party asset is allowed to load. The cards map the local list, not
 *     the oEmbed result, so an offline build (or a deleted post) still renders
 *     the full index.
 *  2. The build-time oEmbed blockquotes stay in the DOM inside `.ig-embeds`,
 *     which is `hidden` until consent. Keeping them server-rendered preserves
 *     the privacy-safe fallback and lets the consent gate reveal real markup
 *     instead of re-fetching.
 *
 * The embed.js loader is NOT emitted here and never loads at rest: the
 * `InstagramGate` island (`client:idle`) injects it through the DomPort only
 * after a click, then reveals the hidden blockquote layer. On a provider
 * failure it leaves the index and shows a local fallback instead.
 *
 * Meta's embed.js creates the final `<iframe>` itself, so build-time markup
 * cannot set that iframe's `title`/`loading`. The figure therefore carries the
 * wrapper label (`aria-label`) and the CSS constrains every embed descendant to
 * the figure width; this is the documented Meta limitation allowed by the plan.
 *
 * The cards reuse the project's `card` surface directly rather than the shared
 * React `Card` component: each card is one external anchor, so it needs
 * `target`/`rel` on that anchor, which the hook-free `Card` does not forward.
 */
import { contactIdentity } from "../../i18n";
import { instagramPosts } from "../../data/instagram";
import { getInstagramEmbeds } from "../../lib/io/instagram";
import InstagramGate from "./InstagramGate.tsx";
import Grid from "../shared/layout/Grid";

const embeds = await getInstagramEmbeds(instagramPosts);
const igHandle = `@${contactIdentity.photoIg}`;
const igHref = `https://instagram.com/${contactIdentity.photoIg}`;

/** `/p/<shortcode>/` for a post, or the raw URL if it cannot be parsed. */
function postPath(url: string): string {
  try {
    const { pathname } = new URL(url);
    return pathname.endsWith("/") ? pathname : `${pathname}/`;
  } catch {
    return url;
  }
}

/** Two-digit catalogue ordinal: `01`, `02`, … */
function ordinal(position: number): string {
  return String(position).padStart(2, "0");
}
---

{instagramPosts.length > 0 ? (
  <div class="photo-index" data-ig-wall>
    {/*
        Click-to-load consent gate. `client:idle` keeps it off the critical path;
        it injects embed.js only on click and toggles the layers below through
        the DomPort, so no third-party request happens at rest.
      */}
    <InstagramGate
      client:idle
      scriptSrc="https://www.instagram.com/embed.js"
      profileHref={igHref}
      handle={igHandle}
      postCount={instagramPosts.length}
    />

    {/*
        The at-rest index. Every card is local: an ordinal, the handle and the
        post path. It stays a plain external link so a visitor can always reach
        the post even when the provider is blocked. `data-ig-gate` is the hook
        the consent gate uses to retire this list once the real embeds load; it
        never removes the list on a load failure.
      */}
    <ol class="photo-index__list" data-ig-gate>
      {instagramPosts.map((url, position) => (
        <li class="photo-index__item">
          <a
            class="card card--interactive photo-index__card"
            href={url}
            target="_blank"
            rel="noopener"
          >
            <span class="photo-index__number" aria-hidden="true">
              {ordinal(position + 1)}
            </span>
            <span class="photo-index__body">
              <span class="photo-index__handle">{igHandle}</span>
              <span class="photo-index__path">{postPath(url)}</span>
            </span>
            <span class="photo-index__action">
              在 Instagram 觀看
              <svg
                class="photo-index__arrow"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 7h10v10" />
                <path d="M7 17 17 7" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ol>

    {/*
        Consent-gated layer. `hidden` keeps the raw oEmbed blockquotes and the
        per-post link fallback out of paint (and out of the accessibility tree)
        until the gate reveals them. `data-ig-embeds` is the hook the gate uses.
      */}
    <div class="ig-embeds" data-ig-embeds hidden>
      <Grid min="19rem" gap={6} className="photo-wall">
        {embeds.map((embed) =>
          embed.html ? (
            <figure
              class="ig-embed"
              role="group"
              aria-label={`Instagram post: ${embed.url}`}
              set:html={embed.html}
            />
          ) : (
            <a
              class="ig-fallback"
              href={embed.url}
              target="_blank"
              rel="noopener"
              aria-label={`在 Instagram 觀看 ${igHandle} 的貼文 ${postPath(embed.url)}`}
              data-embed-failed={embed.failed ? "" : undefined}
            >
              <span class="ig-fallback__glyph" aria-hidden="true">
                ↗
              </span>
              <span class="ig-fallback__label">在 Instagram 觀看</span>
            </a>
          ),
        )}
      </Grid>
    </div>
  </div>
) : (
  <a class="photo-empty" href={igHref} target="_blank" rel="noopener">
    <span class="photo-empty__label">在 Instagram 看更多</span>
    <span class="photo-empty__handle">{igHandle}</span>
    <span class="photo-empty__arrow" aria-hidden="true">
      ↗
    </span>
  </a>
)}
