---
/**
 * Cluster — compatibility shim for MDX pages.
 *
 * The implementation is the shared React primitive in
 * `src/components/shared/layout/Cluster.tsx`; this wrapper only forwards the
 * Astro slot as `children`. It renders on the server with no hydration.
 *
 * Props (same meanings as the old Astro port)
 *  - gap?: 1..12        default: 3
 *  - align?: "start" | "center" | "end" | "baseline"   default: "center"
 *  - justify?: "start" | "center" | "end" | "between"   default: "start"
 *  - as?: tag           element tag, default "div"
 *  - className?: string
 */
import type { ClusterAlign, Gap, Justify } from "../shared/layout/classes";
import Cluster from "../shared/layout/Cluster";
import type { LayoutTag } from "../shared/layout/types";

interface Props {
  gap?: Gap;
  align?: ClusterAlign;
  justify?: Justify;
  as?: LayoutTag;
  className?: string;
}

const {
  gap = 3,
  align = "center",
  justify = "start",
  as: Tag,
  className,
} = Astro.props;
---

<Cluster
  gap={gap}
  align={align}
  justify={justify}
  as={Tag}
  className={className}
>
  <slot />
</Cluster>
