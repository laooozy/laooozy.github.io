---
/**
 * Grid — compatibility shim for MDX pages.
 *
 * The implementation is the shared React primitive in
 * `src/components/shared/layout/Grid.tsx`; this wrapper only forwards the
 * Astro slot as `children`. It renders on the server with no hydration.
 *
 * Props (same meanings as the old Astro port)
 *  - min?: "16rem" | "17rem" | "19rem" …  fluid minimum track, default "16rem"
 *  - gap?: 1..12        default: 5
 *  - columns?: 1..12    force an exact column count
 *  - count?: number     item count exposed as `data-count` for `.grid--cards`
 *  - as?: tag           element tag, default "div"
 *  - className?: string
 */
import type { Columns, Gap, GridMin } from "../shared/layout/classes";
import Grid from "../shared/layout/Grid";
import type { LayoutTag } from "../shared/layout/types";

interface Props {
  min?: GridMin;
  gap?: Gap;
  columns?: Columns;
  count?: number;
  as?: LayoutTag;
  className?: string;
}

const {
  min = "16rem",
  gap = 5,
  columns,
  count,
  as: Tag,
  className,
} = Astro.props;
---

<Grid
  min={min}
  gap={gap}
  columns={columns}
  count={count}
  as={Tag}
  className={className}
>
  <slot />
</Grid>
