---
/**
 * Stack — compatibility shim for MDX pages.
 *
 * The implementation is the shared React primitive in
 * `src/components/shared/layout/Stack.tsx`; this wrapper only forwards the
 * Astro slot as `children`. It renders on the server with no hydration.
 *
 * Props (same meanings as the old Astro port)
 *  - gap?: 1..12        default: 4
 *  - align?: "stretch" | "start" | "center"   default: "stretch"
 *  - as?: tag           element tag, default "div" (e.g. "ul", "section")
 *  - className?: string
 */
import type { Gap, StackAlign } from "../shared/layout/classes";
import Stack from "../shared/layout/Stack";
import type { LayoutTag } from "../shared/layout/types";

interface Props {
  gap?: Gap;
  align?: StackAlign;
  as?: LayoutTag;
  className?: string;
}

const { gap = 4, align = "stretch", as: Tag, className } = Astro.props;
---

<Stack gap={gap} align={align} as={Tag} className={className}>
  <slot />
</Stack>
