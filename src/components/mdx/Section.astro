---
/**
 * Section — a page band with a heading slot and consistent internal rhythm.
 *
 * Astro port of `src/components/layout/Section.tsx`. The default slot is the
 * section body and renders Markdown; an optional `actions` named slot fills
 * the top-right control beside the heading (the React version accepted the
 * same content as a prop because MDX can express it more naturally as a slot).
 *
 * Props
 *  - id?: string        anchor id (also used to label the section)
 *  - heading?: string   renders an <h2> + wires aria-labelledby
 *  - lead?: string      supporting paragraph under the heading
 *  - className?: string
 *
 * Section owns its INTERNAL rhythm only — it sets no outer margin. Wrap
 * sections in a Stack (or the page wrapper) to control the gap between them.
 */
interface Props {
  id?: string;
  heading?: string;
  lead?: string;
  className?: string;
}

const { id, heading, lead, className } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const hasActions = Astro.slots.has("actions");
---

<section
  id={id}
  class:list={["section", className]}
  aria-labelledby={heading && headingId ? headingId : undefined}
>
  {
    (heading || hasActions) && (
      <div class="section__head">
        {heading && (
          <h2 id={headingId} class="section__title">
            {heading}
          </h2>
        )}
        {hasActions && (
          <div class="section__actions">
            <slot name="actions" />
          </div>
        )}
      </div>
    )
  }
  {lead && <p class="section__lead">{lead}</p>}
  <div class="section__body">
    <slot />
  </div>
</section>
