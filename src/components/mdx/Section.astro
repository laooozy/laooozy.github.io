---
/**
 * Section — a page band with a heading slot and consistent internal rhythm.
 *
 * Astro port of the former React `Section` primitive. The default slot is the
 * section body and renders Markdown; an optional `actions` named slot fills
 * the top-right control beside the heading (the React version accepted the
 * same content as a prop because MDX can express it more naturally as a slot).
 *
 * Props
 *  - id?: string        anchor id (also used to label the section)
 *  - heading?: string   renders an <h2> + wires aria-labelledby
 *  - lead?: string      supporting paragraph under the heading
 *  - className?: string
 *  - hidden?: boolean | "empty"
 *      true    → render nothing at all (no <section>, heading or body).
 *      "empty" → render nothing while the default slot has no rendered
 *                content; adding real Markdown body makes the section
 *                appear again. Use it for a section whose placeholder copy
 *                is kept as an MDX comment until the owner supplies
 *                the real body.
 *
 * Section owns its INTERNAL rhythm only — it sets no outer margin. Wrap
 * sections in a Stack (or the page wrapper) to control the gap between them.
 */
interface Props {
  id?: string;
  heading?: string;
  lead?: string;
  className?: string;
  hidden?: boolean | "empty";
}

const { id, heading, lead, className, hidden = false } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const hasActions = Astro.slots.has("actions");
// "empty" opts into the placeholder gate. Render the slot once to know whether
// the author has supplied real body content; the placeholder copy itself lives
// in an MDX comment, so it produces no rendered output.
const bodyHtml =
  hidden === "empty" ? ((await Astro.slots.render("default")) ?? "") : "";
const isHidden =
  hidden === true || (hidden === "empty" && bodyHtml.trim() === "");
---

{
  !isHidden && (
    <section
      id={id}
      class:list={["section", className]}
      aria-labelledby={heading && headingId ? headingId : undefined}
    >
      {
        (heading || hasActions) && (
          <div class="section__head">
            {heading && (
              <h2 id={headingId} class="section__title">
                {heading}
              </h2>
            )}
            {hasActions && (
              <div class="section__actions">
                <slot name="actions" />
              </div>
            )}
          </div>
        )
      }
      {lead && <p class="section__lead">{lead}</p>}
      <div class="section__body">
        <slot />
      </div>
    </section>
  )
}

<style is:global>
  /*
   * The `actions` slot is authored Markdown, so its text arrives wrapped in a
   * paragraph. The action link is inline content; flatten that paragraph so the
   * markup matches the React section's action prop (plain text in the anchor).
   */
  .section__actions p {
    display: inline;
    margin: 0;
  }
</style>
