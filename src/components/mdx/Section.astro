---
/**
 * Section — COMPATIBILITY SHIM. The implementation is the shared React
 * component in `src/components/shared/Section.tsx`; this file exists only so
 * `src/content/pages/home.mdx` and `photographer.mdx` keep building until
 * Tasks 25/27 migrate them to the new component. Task 42 deletes this shim.
 *
 * Named slots cannot cross the Astro/React boundary as React nodes, so the
 * optional `slot="actions"` content is flattened to HTML and handed to the
 * React `Section` through its shim-only `actionsHtml` prop.
 */
import Section from "../shared/Section";

interface Props {
  id?: string;
  heading?: string;
  lead?: string;
  className?: string;
  hidden?: boolean | "empty";
}

const { id, heading, lead, className, hidden = false } = Astro.props;
const actionsHtml = Astro.slots.has("actions")
  ? ((await Astro.slots.render("actions")) ?? "")
  : undefined;
// Astro wraps the default slot in an element even when it is empty, so the
// React emptiness gate cannot see through it. Resolve the gate on the Astro
// side (the old shim did the same) and pass a plain boolean down.
const bodyHtml =
  hidden === "empty" ? ((await Astro.slots.render("default")) ?? "") : "";
const isHidden =
  hidden === true || (hidden === "empty" && bodyHtml.trim() === "");
---

<Section
  id={id}
  heading={heading}
  lead={lead}
  className={className}
  hidden={isHidden}
  actionsHtml={actionsHtml}
>
  <slot />
</Section>
