---
/**
 * InterestCard — COMPATIBILITY SHIM. The implementation is the shared React
 * component in `src/components/shared/InterestCard.tsx`; kept at this path for
 * `home.mdx` until Task 25 migrates it. Task 42 deletes this shim.
 */
import InterestCard from "../shared/InterestCard";

interface Props {
  id?: string;
  title: string;
  className?: string;
  hidden?: boolean | "empty";
}

const { id, title, className, hidden = false } = Astro.props;
const bodyHtml =
  hidden === "empty" ? ((await Astro.slots.render("default")) ?? "") : "";
const isHidden =
  hidden === true || (hidden === "empty" && bodyHtml.trim() === "");
---

<InterestCard id={id} title={title} className={className} hidden={isHidden}>
  <slot />
</InterestCard>
