---
/**
 * AcgMasthead — the ACG page intro.
 *
 * Astro port of the former ACG page masthead: status
 * line (dot + handle + section label), the hero-scale `<h1>`, then the intro
 * stack. The lead line stays a prop because it carries the `text-xl` /
 * `text-muted` / `text-measure` classes; the rest of the intro is authored
 * Markdown through the default slot.
 *
 * Props
 *  - handle: string     the Instagram handle shown in the status line
 *  - title: string      the hero heading (rendered as <h1>)
 *  - label?: string     the section label after the separator, e.g. "ACG"
 *  - intro?: string     the larger muted lead paragraph
 *  - className?: string
 */
import Stack from "./Stack.astro";

interface Props {
  handle: string;
  title: string;
  label?: string;
  intro?: string;
  className?: string;
}

const { handle, title, label, intro, className } = Astro.props;
---

<header class:list={["acg-masthead", className]}>
  <p class="acg-masthead__status">
    <span class="acg-masthead__dot" aria-hidden="true" />
    <span class="acg-masthead__handle">{handle}</span>
    {
      label && (
        <>
          <span class="acg-masthead__sep" aria-hidden="true">
            ·
          </span>
          <span>{label}</span>
        </>
      )
    }
  </p>

  <h1 class="heading heading--hero acg-masthead__title">{title}</h1>

  <Stack gap={4} className="acg-masthead__intro">
    {
      intro && (
        <p class="text text--xl text--muted text--measure">{intro}</p>
      )
    }
    <slot />
  </Stack>
</header>

<style is:global>
  /* Parity with the React masthead's `<Text measure>` body: no extra margins. */
  .acg-masthead__intro > p,
  .acg-masthead__intro > ul,
  .acg-masthead__intro > ol {
    margin: 0;
  }
</style>
