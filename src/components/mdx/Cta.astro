---
/**
 * Cta — COMPATIBILITY SHIM. The implementation is the shared React component
 * in `src/components/shared/Cta.tsx`; `home.mdx` and `photographer.mdx` keep
 * importing this path until Tasks 25/27. Task 42 deletes this shim.
 */
import Cta from "../shared/Cta";

interface Props {
  href: string;
  label?: string;
  variant?: "link" | "photo";
  external?: boolean;
  className?: string;
}

const {
  href,
  label,
  variant = "link",
  external = false,
  className,
} = Astro.props;
---

<Cta
  href={href}
  label={label}
  variant={variant}
  external={external}
  className={className}
>
  <slot />
</Cta>
