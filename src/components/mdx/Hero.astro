---
/**
 * Hero — the home masthead. The fold's anchor: who this is, what's happening
 * now, and the way in.
 *
 * Astro port of the former React `Hero`; same `hero*` classes and markup.
 *
 * Props
 *  - title: string                     the wordmark (rendered as <h1>)
 *  - tagline: string                   one-line description
 *  - nowLabel?: string                 small status label, e.g. "Now"
 *  - nowText?: string                  the "now" line beside the status dot
 *  - meta?: { label; value }[]         right-column spec rows (Base / Now / …)
 *  - className?: string
 *
 * The default slot is optional extra masthead Markdown, appended after the
 * tagline. Two columns ≥60rem (text + spec panel), stacked below.
 */
interface HeroMeta {
  label: string;
  value: string;
}

interface Props {
  title: string;
  tagline: string;
  nowLabel?: string;
  nowText?: string;
  meta?: HeroMeta[];
  className?: string;
}

const {
  title,
  tagline,
  nowLabel,
  nowText,
  meta = [],
  className,
} = Astro.props;
---

<header class:list={["hero", className]}>
  <div class="hero__main">
    {
      nowLabel && (
        <p class="hero__status">
          <span class="hero__dot" aria-hidden="true" />
          <span class="hero__status-label">{nowLabel}</span>
          {nowText && <span class="hero__status-text">{nowText}</span>}
        </p>
      )
    }

    <h1 class="hero__title">
      {title}<span class="hero__period" aria-hidden="true">.</span>
    </h1>

    <p class="hero__tagline">{tagline}</p>

    <slot />
  </div>

  {
    meta.length > 0 && (
      <dl class="hero__meta">
        {meta.map((row) => (
          <div class="hero__meta-row">
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</header>
