---
/**
 * Hero — COMPATIBILITY SHIM. The implementation lives in
 * `src/components/site/Hero.astro` (thin Astro wrapper around the React
 * `HeroView`/`HeroMeta` plus the build-time `NowTicker`). Kept at this path
 * for `home.mdx` until Task 25 migrates it. Task 42 deletes this shim.
 */
import type { HeroMetaItem } from "../shared/HeroMeta";
import Hero from "../site/Hero.astro";

interface Props {
  title: string;
  tagline?: string;
  meta?: HeroMetaItem[];
  className?: string;
}

const { title, tagline, meta = [], className } = Astro.props;
---

<Hero title={title} tagline={tagline} meta={meta} className={className}>
  <slot />
</Hero>
