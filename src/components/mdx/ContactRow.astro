---
/**
 * ContactRow — COMPATIBILITY SHIM. The implementation is the shared React
 * component in `src/components/shared/ContactRow.tsx`; kept at this path for
 * `home.mdx` until Task 25 migrates it. Task 42 deletes this shim.
 */
import ContactRow from "../shared/ContactRow";

interface Props {
  label: string;
  href: string;
  value?: string;
  ariaLabel?: string;
  external?: boolean;
  className?: string;
}

const {
  label,
  href,
  value,
  ariaLabel,
  external = false,
  className,
} = Astro.props;
---

<ContactRow
  label={label}
  href={href}
  value={value}
  ariaLabel={ariaLabel}
  external={external}
  className={className}
>
  <slot />
</ContactRow>
