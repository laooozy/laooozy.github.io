---
/**
 * Card — the reusable glass surface.
 *
 * Renders as a <div> by default, or an <a> when `href` is given (then it is
 * automatically interactive: hover glow + lift). Pass `interactive` to opt a
 * plain <div> into the hover affordance.
 */
interface Props {
  href?: string;
  interactive?: boolean;
  class?: string;
}

const { href, interactive = false, class: className } = Astro.props;
const Tag = href ? "a" : "div";
const isInteractive = interactive || Boolean(href);
---

<Tag {...href ? { href } : {}} class:list={["card", isInteractive && "card--interactive", className]}>
	<slot />
</Tag>

<style>
	.card {
		position: relative;
		display: block;
		padding: var(--space-6);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		-webkit-backdrop-filter: blur(var(--glass-blur));
		backdrop-filter: blur(var(--glass-blur));
		color: var(--text);
		text-decoration: none;
		transition: border-color var(--dur-base) var(--ease-out),
			background-color var(--dur-base) var(--ease-out),
			box-shadow var(--dur-base) var(--ease-out),
			transform var(--dur-base) var(--ease-out);
	}

	.card--interactive:hover,
	.card--interactive:focus-visible {
		border-color: var(--glass-border-strong);
		background: var(--surface-hover);
		box-shadow: var(--glass-glow);
		transform: translateY(-3px);
	}

	.card--interactive:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.card--interactive:hover,
		.card--interactive:focus-visible {
			transition: none;
			transform: none;
		}
	}
</style>
