---
/**
 * LatestPosts — the home page's latest-post grid, rendered at BUILD time.
 *
 * The route (and therefore this component) runs in Astro's server build phase,
 * so it reads the content collection through the I/O edge (`getAllPosts`) and
 * reduces each entry with the pure `toBlogListItem`. There is no React island
 * here: the cards are server-rendered through the shared, hook-free
 * `PostCardView`, the same markup the hydrated blog-listing `PostCard` uses.
 *
 * It stays Astro because of the top-level `await getAllPosts()`; the layout and
 * empty state are the shared React primitives (`Grid`, `BlogEmptyView`).
 *
 * The page content is zh-hant, so the date label is formatted with
 * `DEFAULT_LOCALE` at build time (matching the static MDX body); the fixed chrome
 * is the only locale-reactive part of the site.
 */
import { DEFAULT_LOCALE, t } from "../../i18n/index";
import { formatPostDate, toBlogListItem } from "../../lib/domain/posts";
import { getAllPosts } from "../../lib/io/posts";
import BlogEmptyView from "./BlogEmptyView";
import PostCardView from "./PostCardView";
import Grid from "../shared/layout/Grid";

const posts = (await getAllPosts())
  .slice(0, 4)
  .map((post) => toBlogListItem(post));
---

{posts.length > 0 ? (
  <Grid
    className="grid--cards card-grid"
    count={Math.min(posts.length, 4)}
    gap={5}
  >
    {posts.map((post) => (
      <PostCardView
        href={post.href}
        title={post.title}
        description={post.description}
        dateLabel={formatPostDate(post.date, DEFAULT_LOCALE)}
        datetime={post.date}
        tags={post.tags}
        readLabel={t(DEFAULT_LOCALE, "blog.readPost")}
      />
    ))}
  </Grid>
) : (
  <BlogEmptyView
    heading={t(DEFAULT_LOCALE, "blog.heading")}
    message={t(DEFAULT_LOCALE, "blog.empty")}
    homeLabel={t(DEFAULT_LOCALE, "notFound.backHome")}
    secondaryLabel={t(DEFAULT_LOCALE, "nav.photography")}
  />
)}
