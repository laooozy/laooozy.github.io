---
/**
 * HomePage — the single-page home, shared by all three locales.
 *
 * Composed from the reusable kit only (no bespoke layout CSS beyond two label
 * styles): Hero → Section#about → Section#acg → Section#blog → Section#contact.
 * Every user-facing string comes from src/i18n/ui.ts; the page renders inside
 * BaseLayout (see the thin locale routes in src/pages).
 */
import Hero from "./Hero";
import Card from "./Card";
import PostCard from "./PostCard";
import ChipRow from "./ChipRow";
import Section from "./layout/Section.astro";
import Grid from "./layout/Grid";
import Stack from "./layout/Stack";
import Text from "./ui/Text";
import {
  contactIdentity,
  games,
  resolveLocale,
  useTranslations,
  vtubers,
} from "../i18n/ui";
import {
  blogIndexPath,
  blogPostPath,
  formatPostDate,
  getAllPosts,
} from "../lib/blog";

interface Interest {
  key: string;
  label: string;
  note: string;
  items: readonly string[];
}

const locale = resolveLocale(Astro.currentLocale);
const t = useTranslations(locale);

const latest = (await getAllPosts()).slice(0, 4);
const acgHref = "/acg/";
const allPostsHref = blogIndexPath(locale).replace(/\/$/, "");

const interests: Interest[] = [
  {
    key: "photography",
    label: t.home.interests.photography,
    note: t.home.interests.photographyNote,
    items: [],
  },
  {
    key: "games",
    label: t.home.interests.games,
    note: t.home.interests.gamesNote,
    items: games,
  },
  {
    key: "vtuber",
    label: t.home.interests.vtuber,
    note: t.home.interests.vtuberNote,
    items: vtubers,
  },
];

const quickLinks = [
  { label: t.nav.blog, href: "#blog" },
  { label: t.nav.acg, href: acgHref },
  { label: t.nav.contact, href: "#contact" },
];

const heroMeta = [
  { label: t.home.baseLabel, value: t.home.baseValue },
  {
    label: t.contact.instagramLabel,
    value: `@${contactIdentity.personalIg}`,
  },
];

const contacts = [
  {
    key: "instagram",
    label: t.contact.instagramLabel,
    handle: `@${contactIdentity.personalIg}`,
    href: `https://instagram.com/${contactIdentity.personalIg}`,
  },
  {
    key: "instagram-acg",
    label: t.contact.instagramLabel,
    handle: `@${contactIdentity.acgIg}`,
    href: `https://instagram.com/${contactIdentity.acgIg}`,
  },
  {
    key: "email",
    label: t.contact.emailLabel,
    handle: contactIdentity.email,
    href: `mailto:${contactIdentity.email}`,
  },
];
---

<div class="home">
	<Hero
		title={t.home.title}
		tagline={t.home.tagline}
		nowLabel={t.home.nowLabel}
		nowText={t.home.nowText}
		links={quickLinks}
		linksLabel={t.a11y.quickLinks}
		meta={heroMeta}
	/>

	<Section id="about" heading={t.about.heading} lead={t.home.intro}>
		<Grid min="15rem" gap={5}>
			{
				interests.map((interest) => (
					<Card>
						<h3 class="interest__label">{interest.label}</h3>
						<Text tone="muted">{interest.note}</Text>
						{interest.items.length > 0 && (
							<div class="interest__chips">
								<ChipRow items={interest.items.map((label) => ({ label }))} />
							</div>
						)}
					</Card>
				))
			}
		</Grid>
	</Section>

	<Section id="acg" heading={t.acg.heading}>
		<Card href={acgHref}>
			<Stack gap={3}>
				<Text>{t.acg.note}</Text>
				<span class="acg-card__cta">
					{t.acg.cta} <span aria-hidden="true">→</span>
				</span>
			</Stack>
		</Card>
	</Section>

	<Section id="blog" heading={t.blog.heading}>
		<a slot="actions" class="section__more" href={allPostsHref}>
			{t.button.viewAll} <span aria-hidden="true">→</span>
		</a>

		{
			latest.length > 0 ? (
				<Grid min="18rem" gap={5}>
					{latest.map((post) => (
						<PostCard
							href={blogPostPath(locale, post.id)}
							title={post.data.title}
							description={post.data.description}
							dateLabel={formatPostDate(post.data.date, locale)}
							datetime={post.data.date.toISOString()}
							tags={post.data.tags}
						/>
					))}
				</Grid>
			) : (
				<Text tone="muted">{t.blog.empty}</Text>
			)
		}
	</Section>

	<Section id="contact" heading={t.contact.heading} lead={t.contact.intro}>
		<Stack as="ul" gap={3}>
			{
				contacts.map((contact) => (
					<li class="contact__item">
						<span class="contact__label">{contact.label}</span>
						<a class="contact__link" href={contact.href}>
							{contact.handle}
						</a>
					</li>
				))
			}
		</Stack>
	</Section>
</div>

<style>
	.home {
		display: grid;
		gap: clamp(var(--space-8), 6vw, var(--space-10));
	}

	.interest__label {
		margin: 0 0 var(--space-2);
		font-size: var(--text-lg);
	}

	.interest__chips {
		margin-top: var(--space-4);
	}

	.acg-card__cta {
		font-weight: 600;
		color: var(--accent);
	}

	.section__more {
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
	}

	.contact__item {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2) var(--space-4);
		margin: 0;
	}

	.contact__label {
		min-width: 6rem;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
		color: var(--text-muted);
	}

	.contact__link {
		font-size: var(--text-lg);
		font-weight: 500;
		text-decoration: none;
	}
</style>
