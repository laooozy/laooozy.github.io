---
/**
 * Separator — a hairline rule.
 *
 * Props
 *  - orientation?: "horizontal" | "vertical"   default: "horizontal"
 *  - class?: string
 *
 * Horizontal renders an <hr>; vertical renders a full-height 1px divider for
 * use inside a flex row.
 */
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string;
}
const { orientation = "horizontal", class: className } = Astro.props;
---

{
  orientation === "horizontal" ? (
    <hr class:list={["separator", "separator--horizontal", className]} />
  ) : (
    <div
      role="separator"
      aria-orientation="vertical"
      class:list={["separator", "separator--vertical", className]}
    />
  )
}

<style>
  .separator {
    border: 0;
    background: color-mix(in oklab, var(--glass-border) 45%, transparent);
  }

  .separator--horizontal {
    width: 100%;
    height: 1px;
    margin: 0;
  }

  .separator--vertical {
    width: 1px;
    align-self: stretch;
    min-height: 1em;
  }
</style>
