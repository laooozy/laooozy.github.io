---
/**
 * Input — a single-line text field, on brand.
 *
 * Props
 *  - id?: string
 *  - name?: string
 *  - type?: string          default: "text"
 *  - placeholder?: string   rendered at 4.5:1 (uses --text-muted, not a faint grey)
 *  - value?: string
 *  - required?: boolean
 *  - ariaLabel?: string     set when there is no visible <label>
 *  - class?: string
 *
 * For a labelless search field inside a search bar, pair with a visible label
 * or pass ariaLabel.
 */
interface Props {
  id?: string;
  name?: string;
  type?:
    | "text"
    | "search"
    | "email"
    | "url"
    | "tel"
    | "password"
    | "number";
  placeholder?: string;
  value?: string;
  required?: boolean;
  ariaLabel?: string;
  class?: string;
}
const {
  id,
  name,
  type = "text",
  placeholder,
  value,
  required = false,
  ariaLabel,
  class: className,
} = Astro.props;
---

<input
  id={id}
  name={name}
  type={type}
  placeholder={placeholder}
  value={value}
  required={required}
  aria-label={ariaLabel}
  class:list={["input", className]}
/>

<style>
  .input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: var(--text-base);
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }

  .input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }

  .input:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-surface);
  }
</style>
