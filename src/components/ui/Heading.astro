---
/**
 * Heading — a display heading on the brand type scale.
 *
 * Props
 *  - level?: 1 | 2 | 3 | 4        default: 2 (renders the matching <hN>)
 *  - size?: "hero" | "xl" | "lg" | "md"   optional size override
 *  - tone?: "default" | "muted"
 *  - id?: string         DOM id (e.g. to wire a section's aria-labelledby)
 *  - class?: string
 *
 * Global element styles already cover the base scale; `size` is for the few
 * places that need to break it (e.g. a hero wordmark).
 */
import type { HTMLTag } from "astro/types";

interface Props {
  level?: 1 | 2 | 3 | 4;
  size?: "hero" | "xl" | "lg" | "md";
  tone?: "default" | "muted";
  id?: string;
  class?: string;
}
const { level = 2, size, tone = "default", id, class: className } = Astro.props;
// Typed as HTMLTag so a dynamic tag keeps its intrinsic props (id, class, …).
const Tag: HTMLTag = `h${level}`;
---

<Tag
  id={id}
  class:list={[
    "heading",
    size && `heading--${size}`,
    tone === "muted" && "heading--muted",
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .heading {
    margin: 0;
  }

  .heading--muted {
    color: var(--text-muted);
  }

  .heading--md {
    font-size: var(--text-xl);
  }

  .heading--lg {
    font-size: var(--text-2xl);
  }

  .heading--xl {
    font-size: var(--text-3xl);
  }

  .heading--hero {
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
  }
</style>
