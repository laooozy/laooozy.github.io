---
/**
 * BlogPagination — build-time prev/next controls for a paginated listing.
 *
 * Renders nothing when there is only one page. Prev/next are control-style
 * links (the same outlined pill language as the filter chips); the unavailable
 * direction is a non-interactive, `aria-hidden` stub so the layout never jumps.
 * The `aria-label` on the nav is the localised "Page N of M" string, which
 * doubles as the visible status in the middle of the bar.
 */
import { useTranslations, type Locale } from "../i18n/ui";

interface Pagination {
  currentPage: number;
  lastPage: number;
  url: { prev?: string; next?: string };
}

interface Props {
  locale: Locale;
  pagination: Pagination;
  class?: string;
}

const { locale, pagination, class: className } = Astro.props;
const t = useTranslations(locale);
const status = t.blog.pageOf
  .replace("{current}", String(pagination.currentPage))
  .replace("{last}", String(pagination.lastPage));
---

<nav class:list={["pagination", className]} aria-label={status}>
  {
    pagination.url.prev ? (
      <a class="pagination__link" href={pagination.url.prev} rel="prev">
        <span aria-hidden="true">←</span>
        {t.blog.prev}
      </a>
    ) : (
      <span class="pagination__link is-disabled" aria-hidden="true">
        <span aria-hidden="true">←</span>
        {t.blog.prev}
      </span>
    )
  }

  <span class="pagination__status">{status}</span>

  {
    pagination.url.next ? (
      <a class="pagination__link" href={pagination.url.next} rel="next">
        {t.blog.next}
        <span aria-hidden="true">→</span>
      </a>
    ) : (
      <span class="pagination__link is-disabled" aria-hidden="true">
        {t.blog.next}
        <span aria-hidden="true">→</span>
      </span>
    )
  }
</nav>

<style>
  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .pagination__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in oklab, var(--glass-border) 55%, transparent);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition:
      background-color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }

  .pagination__link:hover,
  .pagination__link:focus-visible {
    background: var(--accent-surface);
    border-color: var(--glass-border-strong);
    color: var(--text);
  }

  .pagination__link span {
    color: var(--accent);
  }

  .pagination__link.is-disabled {
    color: var(--text-muted);
    opacity: 0.55;
  }

  .pagination__link.is-disabled span {
    color: inherit;
  }

  .pagination__status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }
</style>
