---
/**
 * PostCard — a blog post rendered on a card surface.
 *
 * Props
 *  - href: string
 *  - title: string
 *  - description: string
 *  - dateLabel?: string      human date, already localised
 *  - datetime?: string       machine ISO date for <time datetime>
 *  - readingTime?: string    localised, e.g. "約 3 分鐘閱讀"
 *  - tags?: string[]
 *  - class?: string
 *
 * Wraps the shared Card (so it inherits the interactive hover lift) and stacks
 * the meta, title, description and tags.
 */
import Card from "./Card.astro";
import Cluster from "./layout/Cluster.astro";
import Stack from "./layout/Stack.astro";
import Text from "./ui/Text.astro";
import ChipRow from "./ChipRow.astro";

interface Props {
  href: string;
  title: string;
  description: string;
  dateLabel?: string;
  datetime?: string;
  readingTime?: string;
  tags?: string[];
  class?: string;
}
const {
  href,
  title,
  description,
  dateLabel,
  datetime,
  readingTime,
  tags = [],
  class: className,
} = Astro.props;
---

<Card href={href} class:list={["post-card", className]}>
  <Stack gap={3}>
    {
      (dateLabel || readingTime) && (
        <Cluster justify="between" gap={3} align="baseline">
          {dateLabel && (
            <time class="post-card__date" datetime={datetime}>
              {dateLabel}
            </time>
          )}
          {readingTime && (
            <Text as="span" size="xs" tone="muted">
              {readingTime}
            </Text>
          )}
        </Cluster>
      )
    }
    <h3 class="post-card__title">{title}</h3>
    <Text tone="muted">{description}</Text>
    {tags.length > 0 && <ChipRow items={tags.map((label) => ({ label }))} />}
  </Stack>
</Card>

<style>
  .post-card {
    height: 100%;
  }

  .post-card__date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-muted);
  }

  .post-card__title {
    margin: 0;
    font-size: var(--text-xl);
  }
</style>
