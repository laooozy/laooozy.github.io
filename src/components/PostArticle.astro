---
/**
 * PostArticle — the shared renderer for a single blog post, reused by every
 * locale's `[slug]` route. Reuses the `Card` glass shell and shows the title,
 * date, estimate reading time, tag links, a back-to-index link, and the body.
 */
import { render } from "astro:content";
import Card from "./Card.astro";
import { useTranslations, type Locale } from "../i18n/ui";
import {
  blogIndexPath,
  blogTagPath,
  estimateReadingTime,
  formatPostDate,
  type Post,
} from "../lib/blog";

interface Props {
  post: Post;
  locale: Locale;
}

const { post, locale } = Astro.props;
const t = useTranslations(locale);
const { Content } = await render(post);
const readLabel = t.blog.readTime.replace(
  "{minutes}",
  String(estimateReadingTime(post.body)),
);
---

<nav class="post-back" aria-label={t.blog.backToIndex}>
	<a class="post-back__link" href={blogIndexPath(locale)}>
		← {t.blog.backToIndex}
	</a>
</nav>

<Card>
	<article class="post">
		<header class="post__header">
			<h1 class="post__title">{post.data.title}</h1>
			<p class="post__meta">
				<time class="post__date" datetime={post.data.date.toISOString()}>
					{formatPostDate(post.data.date, locale)}
				</time>
				<span class="post__dot" aria-hidden="true">·</span>
				<span class="post__reading">{readLabel}</span>
			</p>
			{
				post.data.tags.length > 0 && (
					<ul class="post__tags" aria-label={t.blog.tagged}>
						{post.data.tags.map((tag) => (
							<li>
								<a class="post__tag" href={blogTagPath(locale, tag)}>
									{tag}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</header>

		<div class="post__body">
			<Content />
		</div>
	</article>
</Card>

<style>
	.post-back {
		margin-bottom: var(--space-5);
	}

	.post-back__link {
		font-size: var(--text-sm);
		font-weight: 500;
		color: var(--accent);
		text-decoration: none;
	}

	.post-back__link:hover {
		color: var(--text);
	}

	.post__header {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-5);
		border-bottom: 1px solid
			color-mix(in oklab, var(--glass-border) 40%, transparent);
	}

	.post__title {
		margin: 0 0 var(--space-3);
		font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
		line-height: var(--leading-tight);
	}

	.post__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-2);
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--text-xs);
		letter-spacing: var(--tracking-wide);
		color: var(--text-muted);
	}

	.post__tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-4);
		list-style: none;
	}

	.post__tag {
		display: inline-block;
		padding: 0 var(--space-2);
		border-radius: var(--radius-sm);
		background: var(--accent-soft);
		color: var(--text);
		font-size: var(--text-xs);
		text-decoration: none;
	}

	.post__tag:hover,
	.post__tag:focus-visible {
		/* Solid --accent, not the gradient: dark-on-#7c3aed only reaches 3.47:1. */
		background: var(--accent);
		color: var(--text-on-accent);
	}

	.post__body {
		max-width: var(--measure, 68ch);
		color: var(--text);
		line-height: var(--leading-relaxed);
	}

	.post__body :global(h2) {
		margin: var(--space-8) 0 var(--space-3);
		font-size: var(--text-xl);
		line-height: var(--leading-tight);
	}

	.post__body :global(h3) {
		margin: var(--space-6) 0 var(--space-2);
		font-size: var(--text-lg);
	}

	.post__body :global(p) {
		margin: 0 0 var(--space-4);
	}

	.post__body :global(ul),
	.post__body :global(ol) {
		margin: 0 0 var(--space-4);
		padding-inline-start: var(--space-6);
	}

	.post__body :global(li) {
		margin-bottom: var(--space-2);
	}

	.post__body :global(a) {
		color: var(--accent);
	}

	.post__body :global(blockquote) {
		margin: 0 0 var(--space-4);
		padding-inline-start: var(--space-4);
		border-inline-start: 1px solid var(--glass-border-strong);
		color: var(--text-muted);
	}

	.post__body :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	.post__body :global(pre) {
		overflow-x: auto;
		padding: var(--space-4);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--surface);
	}

	.post__body > :global(:first-child) {
		margin-top: 0;
	}

	.post__body > :global(:last-child) {
		margin-bottom: 0;
	}
</style>
