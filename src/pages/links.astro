---
/**
 * Useful links — `/links/`.
 *
 * The whole list is ONE hand-edited Markdown entry (`src/content/links/index.md`).
 * `parseLinksMarkdown` turns that small format into records at build time, and
 * `LinksList` renders them as cards from the generated shadcn primitives.
 *
 * The heading stays fixed chrome: it is emitted in all three locales with the
 * static `[data-l]` toggle, so the language switch costs no React island and no
 * client state. The authored intro and link copy stay zh-hant, like every other
 * page body.
 */
import LinksList from "../components/links/LinksList";
import BackLink from "../components/site/BackLink.astro";
import T from "../components/site/T";
import { getTranslations } from "../i18n";
import BaseLayout from "../layouts/BaseLayout.astro";
import { parseLinksMarkdown } from "../lib/domain/links";
import { getLinksEntry } from "../lib/io/pages";

const entry = await getLinksEntry();
const { intro, links } = parseLinksMarkdown(entry.body ?? "");
const t = getTranslations("zh-hant");
---

<BaseLayout title={t.links.title}>
  <article class="mx-auto max-w-(--container-narrow)" lang="zh-Hant">
    <div class="pb-(--space-5)">
      <BackLink />
    </div>
    <header class="border-b border-border/40 pb-(--space-5)">
      <h1 class="m-0 font-heading text-[length:var(--text-page-title)] leading-tight tracking-[var(--tracking-display)] text-balance">
        <T k="links.title" />
      </h1>
      {intro.length > 0 ? (
        <div class="mt-(--space-4) max-w-(--measure) space-y-(--space-3)">
          {intro.map((paragraph) => (
            <p class="m-0 text-sm text-muted-foreground cjk-label">
              {paragraph}
            </p>
          ))}
        </div>
      ) : null}
    </header>
    <div class="pt-(--space-6)">
      <LinksList links={links} />
    </div>
  </article>
</BaseLayout>
