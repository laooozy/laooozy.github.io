---
/**
 * Useful links — `/links/`.
 *
 * The whole list is ONE Markdown entry (`src/content/links/index.md`) rendered
 * here with Astro's `render()`. The visible heading is NOT in the Markdown: it
 * is emitted in all three locales with the existing `[data-l]` toggle, so the
 * language switch costs no React island and no client state.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import T from "../components/T";
import { useTranslations } from "../i18n/ui";

const entry = await getEntry("links", "index");
if (!entry) {
  throw new Error("Missing links entry: src/content/links/index.md");
}
const { Content } = await render(entry);
const t = useTranslations("zh-hant");
---

<BaseLayout title={t.links.title}>
	<article class="links">
		{/*
		 * The page's one clear action. The sticky brand also links home, but a
		 * short page with a single external row is otherwise a dead end, so it
		 * gets the same quiet back pill the ACG page uses. The label is zh-hant
		 * content, like the Markdown body; the fixed `<h1>` still switches.
		 */}
		<nav class="links__rail" aria-label="回到首頁" lang="zh-Hant">
			<a class="links-back" href="/">
				<span class="links-back__arrow" aria-hidden="true">←</span>
				<span>回到首頁</span>
			</a>
		</nav>
		<header class="links__header">
			<h1 class="links__title"><T k="links.title" /></h1>
		</header>
		<p class="links__note" lang="zh-Hant">
			以下為本網站與相關專案的來源連結，內容以繁體中文呈現。
		</p>
		<div class="links__body">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.links {
		max-width: var(--container-narrow);
		margin-inline: auto;
	}

	.links__rail {
		padding-bottom: var(--space-5);
	}

	/* Quiet back pill, matching the ACG page's `.acg-back`. */
	.links-back {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		min-block-size: 44px;
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-pill);
		background: var(--surface);
		color: var(--text-muted);
		font-size: var(--text-sm);
		font-weight: 500;
		text-decoration: none;
		transition:
			background-color var(--dur-fast) var(--ease-out),
			border-color var(--dur-fast) var(--ease-out),
			color var(--dur-fast) var(--ease-out);
	}

	.links-back:hover {
		background: var(--accent-surface);
		border-color: var(--glass-border-strong);
		color: var(--text);
	}

	.links-back__arrow {
		color: var(--accent);
	}

	.links__header {
		padding-bottom: var(--space-5);
		border-bottom: 1px solid
			color-mix(in oklab, var(--glass-border) 40%, transparent);
	}

	.links__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: var(--text-page-title);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-display);
		text-wrap: balance;
	}

	.links__note {
		max-width: var(--measure);
		margin: 0;
		padding-bottom: var(--space-4);
		font-size: var(--text-sm);
		color: var(--text-muted);
	}

	.links__body {
		padding-top: var(--space-6);
		color: var(--text);
		font-size: var(--text-lg);
		line-height: var(--leading-relaxed);
	}

	.links__body :global(> p:first-child) {
		max-width: var(--measure);
		margin: 0 0 var(--space-6);
		color: var(--text-muted);
	}

	.links__body :global(ul) {
		display: grid;
		gap: var(--space-3);
		max-width: var(--measure);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.links__body :global(li) {
		position: relative;
		min-inline-size: 0;
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--glass-border);
		border-radius: var(--radius-md);
		background: var(--surface);
		transition: border-color var(--dur-fast) var(--ease-out);
	}

	/*
	 * Stretched link: the row's own anchor owns a transparent overlay that
	 * covers the whole card, so the padding and the note next to the link are
	 * tappable too. The Markdown is untouched and the card look is unchanged.
	 */
	.links__body :global(li > a::after) {
		content: "";
		position: absolute;
		inset: 0;
	}

	.links__body :global(a) {
		color: var(--accent);
		font-weight: 500;
		text-decoration: none;
	}

	.links__body :global(li:hover) {
		border-color: var(--glass-border-strong);
	}

	.links__body :global(a:hover) {
		color: var(--text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	/* The focus ring marks the row that is now the target, not the text box. */
	.links__body :global(li:has(> a:focus-visible)) {
		border-color: var(--glass-border-strong);
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	.links__body :global(li > a:focus-visible) {
		outline: none;
	}
</style>
