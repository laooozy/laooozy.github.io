---
/**
 * Photography page — `/photographer/`.
 *
 * The page body is authored in `src/content/pages/photographer.mdx` and
 * rendered here with Astro's `render()`. This route owns only the shell:
 * `BaseLayout` (with the entry's frontmatter title/description for the document
 * + OG metadata) and the `.photography` / `lang="zh-Hant"` wrapper that the
 * photography grid and entrance-reveal rules target. The Instagram embeds are
 * resolved by `InstagramWall.astro`, not here, so the route stays free of
 * network I/O.
 */
import BackLink from "../components/site/BackLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderPage } from "../lib/io/pages";

const { entry, Content } = await renderPage("photographer");
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="photography" lang="zh-Hant">
    <BackLink />
    <div class="photography__body">
      <Content />
    </div>
  </div>
</BaseLayout>
