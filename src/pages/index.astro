---
/**
 * Home — `/`.
 *
 * The page body is authored Markdown/MDX in `src/content/pages/home.mdx`; this
 * route stays thin: it loads the entry, renders it, and supplies the shell.
 * `BaseLayout` owns the document metadata and falls back to `home.title` /
 * `home.tagline` when the entry has no overrides. The content wrapper carries
 * `lang="zh-Hant"` because page content stays zh-hant while the fixed chrome
 * is trilingual.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "home");
if (!entry) {
  throw new Error("Missing home entry: src/content/pages/home.mdx");
}
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
	<div class="home" lang="zh-Hant">
		<Content />
	</div>
</BaseLayout>
