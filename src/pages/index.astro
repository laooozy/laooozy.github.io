---
/**
 * Home — `/`.
 *
 * The page body is authored Markdown/MDX in `src/content/pages/home.mdx`; this
 * route stays thin: it loads the entry, renders it, and supplies the shell.
 * `BaseLayout` owns the document metadata and falls back to `home.title`
 * when the entry has no override. The content wrapper carries
 * `lang="zh-Hant"` because page content stays zh-hant while the fixed chrome
 * is trilingual.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderPage } from "../lib/io/pages";

const { entry, Content } = await renderPage("home");
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div
    class="home grid gap-[clamp(var(--space-8),6vw,var(--space-10))]"
    lang="zh-Hant"
  >
    <Content />
  </div>
</BaseLayout>
