---
/**
 * ACG page — `/acg/`.
 *
 * The page body is authored in `src/content/pages/acg.mdx` and rendered here
 * with Astro's `render()`. This route owns only the shell: `BaseLayout` (with
 * the entry's frontmatter title/description for the document + OG metadata) and
 * the `.acg` / `lang="zh-Hant"` wrapper that the ACG grid and entrance-reveal
 * rules target. The Instagram embeds are resolved by `InstagramWall.astro`, not
 * here, so the route stays free of network I/O.
 */
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entry = await getEntry("pages", "acg");
if (!entry) {
  throw new Error("Missing pages entry: src/content/pages/acg.mdx");
}
const { Content } = await render(entry);
---

<BaseLayout
	title={entry.data.title}
	description={entry.data.description}
>
	<div class="acg" lang="zh-Hant">
		<nav class="acg-rail" aria-label="回到首頁">
			<a class="acg-back" href="/">
				<span class="acg-back__arrow" aria-hidden="true">←</span>
				<span>回到首頁</span>
			</a>
		</nav>
		<Content />
	</div>
</BaseLayout>
