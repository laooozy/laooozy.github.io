---
/**
 * zh-hans blog index — served at `/zh-hans/blog/`. Same pagination rules as the
 * default locale; shows only `lang: "zh-hans"` posts.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import { useTranslations } from "../../../i18n/ui";
import {
  blogArchivePath,
  blogTagPath,
  collectPeriods,
  collectTags,
  formatPeriodLabel,
  getPostsWithFallback,
  PAGE_SIZE,
} from "../../../lib/blog";

const locale = "zh-hans" as const;

export async function getStaticPaths({ paginate }: { paginate: import("astro").PaginateFunction }) {
  const posts = await getPostsWithFallback("zh-hans");
  return paginate(posts, { pageSize: PAGE_SIZE });
}

const t = useTranslations(locale);
const { page } = Astro.props;

const allPosts = await getPostsWithFallback(locale);
const tags = collectTags(allPosts).map((tag) => ({
  label: tag,
  href: blogTagPath(locale, tag),
}));
const periods = collectPeriods(allPosts)
  .filter((period) => period.length === 4)
  .map((period) => ({
    label: formatPeriodLabel(period, locale),
    href: blogArchivePath(locale, period),
  }));
---

<BaseLayout title={t.blog.heading}>
	<BlogList
		posts={page.data}
		locale={locale}
		heading={t.blog.heading}
		tags={tags}
		periods={periods}
		pagination={page}
	/>
</BaseLayout>
