---
/**
 * Year archive — `/blog/archive/[period]/` where period is `YYYY`.
 * The filter tray only links years, so month routes are not generated.
 */
import BlogListing from "../../../layouts/BlogListing.astro";
import { collectPeriods } from "../../../lib/domain/posts";
import { getAllPosts } from "../../../lib/io/posts";

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return collectPeriods(posts).map((period) => ({
    params: { period },
    props: { period },
  }));
}

const { period } = Astro.props;
---

<BlogListing heading={{ kind: "archive", period }} />
