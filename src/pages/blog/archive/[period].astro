---
/**
 * Year archive — `/blog/archive/[period]/` where period is `YYYY`.
 * Build-time date filtering; the index/tag filter chips only ever link years,
 * so month routes are deliberately not generated.
 *
 * Posts are reduced to plain, serializable fields before they cross into the
 * `BlogList` React island; the heading is a locale-independent descriptor, so
 * the island re-derives every label from the store locale on the client.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/blog/BlogList";
import {
  blogArchivePath,
  blogTagPath,
  collectPeriods,
  collectTags,
  formatPeriodLabel,
  matchesPeriod,
  toBlogListItem,
} from "../../../lib/domain/posts";
import { getAllPosts } from "../../../lib/io/posts";

const locale = "zh-hant" as const;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return collectPeriods(posts)
    .filter((period) => period.length === 4)
    .map((period) => ({
      params: { period },
      props: { period },
    }));
}

const { period } = Astro.props;
const allPosts = await getAllPosts();
const posts = allPosts
  .filter((post) => matchesPeriod(post, period))
  .map(toBlogListItem);
const tags = collectTags(allPosts).map((tag) => ({
  tag,
  href: blogTagPath(tag),
}));
const periods = collectPeriods(allPosts)
  .filter((key) => key.length === 4)
  .map((key) => ({
    period: key,
    href: blogArchivePath(key),
    active: key === period,
  }));
const heading = { kind: "archive", period } as const;
---

<BaseLayout title={formatPeriodLabel(period, locale)}>
  <BlogList
    client:load
    posts={posts}
    heading={heading}
    tags={tags}
    periods={periods}
  />
</BaseLayout>
