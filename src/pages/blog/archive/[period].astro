---
/**
 * zh-hant date archive — `/blog/archive/[period]/` where period is `YYYY` or
 * `YYYY-MM`. Build-time date filtering, linked from the index filter chips.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList.astro";
import {
  blogArchivePath,
  blogTagPath,
  collectPeriods,
  collectTags,
  formatPeriodLabel,
  matchesPeriod,
} from "../../../lib/domain/posts";
import { getAllPosts } from "../../../lib/io/posts";

const locale = "zh-hant" as const;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return collectPeriods(posts).map((period) => ({
    params: { period },
    props: { period },
  }));
}

const { period } = Astro.props;
const allPosts = await getAllPosts();
const posts = allPosts.filter((post) => matchesPeriod(post, period));
const tags = collectTags(allPosts).map((tag) => ({
  label: tag,
  href: blogTagPath(tag),
}));
const periods = collectPeriods(allPosts).map((key) => ({
  label: formatPeriodLabel(key, locale),
  href: blogArchivePath(key),
  active: key === period,
}));
---

<BaseLayout title={formatPeriodLabel(period, locale)}>
	<BlogList
		posts={posts}
		locale={locale}
		heading={formatPeriodLabel(period, locale)}
		tags={tags}
		periods={periods}
	/>
</BaseLayout>
