---
/**
 * Tag pages — `/blog/tags/[tag]/` (default locale, unprefixed).
 * Tag is the raw tag string; Astro percent-encodes it in the URL.
 *
 * Posts are reduced to plain, serializable fields before they cross into the
 * `BlogList` React island; the heading is a locale-independent descriptor, so
 * the island re-derives every label from the store locale on the client.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogList from "../../../components/BlogList";
import SearchModal from "../../../components/SearchModal";
import { useTranslations } from "../../../i18n/ui";
import {
  blogArchivePath,
  blogTagPath,
  collectPeriods,
  collectTags,
  toBlogListItem,
} from "../../../lib/domain/posts";
import { getAllPosts } from "../../../lib/io/posts";

const locale = "zh-hant" as const;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return collectTags(posts).map((tag) => ({ params: { tag }, props: { tag } }));
}

const t = useTranslations(locale);
const { tag } = Astro.props;

const allPosts = await getAllPosts();
const posts = allPosts
  .filter((post) => post.data.tags.includes(tag))
  .map(toBlogListItem);
const tags = collectTags(allPosts).map((name) => ({
  tag: name,
  href: blogTagPath(name),
  active: name === tag,
}));
const periods = collectPeriods(allPosts)
  .filter((period) => period.length === 4)
  .map((period) => ({
    period,
    href: blogArchivePath(period),
  }));
const heading = { kind: "tag", tag } as const;
---

<BaseLayout title={`${t.blog.byTag} · ${tag}`}>
	<BlogList client:load posts={posts} heading={heading} tags={tags} periods={periods}>
		<SearchModal client:idle />
	</BlogList>
</BaseLayout>
