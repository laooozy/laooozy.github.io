---
import type { PaginateFunction as Paginate } from "astro";
import BlogListing from "../../layouts/BlogListing.astro";
import { PAGE_SIZE, toBlogListItem } from "../../lib/domain/posts";
import { getAllPosts } from "../../lib/io/posts";

export async function getStaticPaths({ paginate }: { paginate: Paginate }) {
  return paginate(await getAllPosts(), { pageSize: PAGE_SIZE });
}

const { page } = Astro.props;
const pagination = {
  currentPage: page.currentPage,
  lastPage: page.lastPage,
  url: { prev: page.url.prev, next: page.url.next },
};
---

<BlogListing
  heading={{ kind: "index" }}
  posts={page.data.map(toBlogListItem)}
  pagination={pagination}
/>
