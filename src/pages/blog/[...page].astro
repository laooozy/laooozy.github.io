---
/**
 * zh-hant blog index — served unprefixed at `/blog/` (default locale).
 * 4 posts per page, newest first; drafts excluded; build-time pagination.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import { useTranslations } from "../../i18n/ui";
import {
  blogArchivePath,
  blogTagPath,
  collectPeriods,
  collectTags,
  formatPeriodLabel,
  getAllPosts,
  PAGE_SIZE,
} from "../../lib/blog";

const locale = "zh-hant" as const;

export async function getStaticPaths({ paginate }: { paginate: import("astro").PaginateFunction }) {
  const posts = await getAllPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}

const t = useTranslations(locale);
const { page } = Astro.props;

const allPosts = await getAllPosts();
const tags = collectTags(allPosts).map((tag) => ({
  label: tag,
  href: blogTagPath(locale, tag),
}));
const periods = collectPeriods(allPosts)
  .filter((period) => period.length === 4)
  .map((period) => ({
    label: formatPeriodLabel(period, locale),
    href: blogArchivePath(locale, period),
  }));
---

<BaseLayout title={t.blog.heading}>
	<BlogList
		posts={page.data}
		locale={locale}
		heading={t.blog.heading}
		tags={tags}
		periods={periods}
		pagination={page}
	/>
</BaseLayout>
