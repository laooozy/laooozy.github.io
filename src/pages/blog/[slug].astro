---
/**
 * zh-hant blog post — served unprefixed at `/blog/[slug]/` (default locale).
 * Content is language-agnostic, so every locale renders the same post set.
 * Drafts are excluded by `getAllPosts`.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostArticle from "../../components/PostArticle.astro";
import { getAllPosts } from "../../lib/io/posts";
import type { Post } from "../../lib/domain/posts";

const locale = "zh-hant" as const;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
>
	<PostArticle post={post} locale={locale} />
</BaseLayout>
