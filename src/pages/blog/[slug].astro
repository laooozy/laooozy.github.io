---
/**
 * zh-hant blog post — served unprefixed at `/blog/[slug]/` (default locale).
 * Drafts are excluded by `getPostsByLocale`.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostArticle from "../../components/PostArticle.astro";
import { getPostsByLocale, type Post } from "../../lib/blog";

const locale = "zh-hant" as const;

export async function getStaticPaths() {
  const posts = await getPostsByLocale("zh-hant");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout title={post.data.title} description={post.data.description}>
	<PostArticle post={post} locale={locale} />
</BaseLayout>
