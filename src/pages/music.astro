---
/**
 * Music page — `/music/`.
 *
 * The page body is authored in `src/content/pages/music.mdx` and rendered here
 * with Astro's `render()`. This route owns only the shell: `BaseLayout` (with
 * the entry's frontmatter title/description for the document + OG metadata) and
 * the `.music-page` / `lang="zh-Hant"` wrapper. The searchable list itself is
 * the `MusicLibrary` island mounted from the MDX, so the route stays free of
 * network I/O and client state.
 */
import BackLink from "../components/site/BackLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { renderPage } from "../lib/io/pages";

const { entry, Content } = await renderPage("music");
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div
    class="music-page grid gap-[clamp(var(--space-3),2vw,var(--space-5))]"
    lang="zh-Hant"
  >
    <BackLink />
    <Content />
  </div>
</BaseLayout>
