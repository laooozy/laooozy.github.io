---
/**
 * en blog post — served at `/en/blog/[slug]/`. Content is language-agnostic,
 * so this renders the same post set as every other locale, with the English
 * chrome. Drafts are excluded by `getAllPosts`.
 */
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostArticle from "../../../components/PostArticle.astro";
import { getAllPosts, type Post } from "../../../lib/blog";

const locale = "en" as const;

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	ogType="article"
>
	<PostArticle post={post} locale={locale} />
</BaseLayout>
